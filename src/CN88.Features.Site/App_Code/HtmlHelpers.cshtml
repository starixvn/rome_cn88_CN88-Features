@helper FormatNumber(decimal value)
{
    @value.ToString("#,##0.00")
}
@helper FormatNumber(int value)
{
    @value.ToString("#,##0")
}
@helper RenderHeaderNumberCell(decimal cellValue, string cellClass = "")
{
    <th class="text-right @cellClass">
        @FormatNumber(cellValue)
    </th>
}
@helper RenderHeaderNumberCell(int cellValue, string cellClass = "")
{
    <th class="text-right @cellClass">
        @FormatNumber(cellValue)
    </th>
}
@helper RenderNumberCell(decimal cellValue, string cellClass = "")
{
    <td class="text-right @cellClass">
        @FormatNumber(cellValue)
    </td>
}
@helper RenderNumberCell(int cellValue, string cellClass = "")
{
    <td class="text-right @cellClass">
        @FormatNumber(cellValue)
    </td>
}