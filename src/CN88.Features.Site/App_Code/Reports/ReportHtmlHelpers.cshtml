@helper FormatPercent(decimal percent)
{
    @percent.ToString("#,##0.0000")
}
@helper RenderPercentCell(decimal percent, string cellClass = "")
{
    <td class="text-right @cellClass">
        @FormatPercent(percent)
    </td>
}
@helper RenderStockPercentCell(decimal stock, decimal totalStock, string cellClass = "")
{
var stockPercent = totalStock == 0 ? 0 : stock / totalStock * 100;
    @RenderPercentCell(stockPercent)
}