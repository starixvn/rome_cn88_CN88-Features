@using CN88.Features.Site.Shared.ViewModels.Components
@helper Render(SingleSelectionViewModel model, string id, string label)
{
    <div class="form-group">
        <label>@label</label>
        <select id="@id">
            @foreach (var group in model.Items)
            {
                <option value="@group.Value" @(group.Selected ? " selected=\"selected\"" : string.Empty)>@group.Text</option>
            }
        </select>
        <input type="hidden" name="UserSelectedSportGroupId" id="UserSelected@id" value="@model.UserSelectedId" />
    </div>
}