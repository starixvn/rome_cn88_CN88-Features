@using CN88.Features.Shared.AppResources
@using CN88.Features.Site.Shared.ViewModels.Components
@helper Render(BreadcrumbLevelViewModel viewModel, string currentRequestUrl, IEnumerable<string> breadcrumbParamByLevel)
{
var linkLength = viewModel.BreadcrumbLevel != null ? viewModel.BreadcrumbLevel.Count() : 0;
var linkIndex = 0;
    <div class="breadcrumb-container">
        <ul class="breadcrumb">
            <li>
                <a class="breadcrumb-link"
                   href="@viewModel.MainLink">
                    @(SharedResources.Main)
                </a>
            </li>
            @foreach (var custinfo in viewModel.BreadcrumbLevel)
            {
                <li>
                    <a class="breadcrumb-link"
                       href="@(viewModel.BuildBreadcrumbLink(custinfo, currentRequestUrl, breadcrumbParamByLevel, linkIndex))">
                        @(custinfo.CustName)
                    </a>
                </li>

                linkIndex++;
            }
        </ul>
    </div>
}