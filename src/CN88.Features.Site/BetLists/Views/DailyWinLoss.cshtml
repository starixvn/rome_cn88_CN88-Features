@model DailyWinLossViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}

<div class="page-title">@BetListsResources.BetList</div>
<table class="tbl-style2">
    <thead>
        <tr>
            <th>@BetListsResources.DateTime</th>
            <th>@BetListsResources.Member/@BetListsResources.Commission</th>
            <th>@BetListsResources.BetID/<br />@BetListsResources.BetType</th>
            <th>@BetListsResources.Details</th>
            <th>@BetListsResources.Stake</th>
            <th>@BetListsResources.WinLoss</th>
            <th>@BetListsResources.Status</th>
            <th>@BetListsResources.AgentPercent</th>

            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th>@BetListsResources.MAPercent</th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th>@BetListsResources.SMAPercent</th>
                <th>@BetListsResources.CoPercent</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.WinLoss.Any())
        {
            foreach (var w in Model.WinLoss)
            {
                <tr>
                    <td>@w.WinLossDateStr<br />@w.WinLossTimeStr</td>
                    <td>@w.CustName<br />@w.MemberCommission</td>
                    <td>@w.BetId<br />@w.BetType</td>
                    <td>@w.Detail</td>
                    <td>@HtmlHelpers.FormatNumber((int)Math.Round(w.Stake))</td>
                    <td>@HtmlHelpers.FormatNumber(w.WinLoss)</td>
                    <td>@w.Status</td>
                    <td>@HtmlHelpers.FormatNumber((int)Math.Round(w.AgentPercent))</td>

                    @if (Model.CustLevel.IsMasterOrSuperLevel())
                    {
                        <td>@HtmlHelpers.FormatNumber((int)Math.Round(w.MasterPercent))</td>
                    }

                    @if (Model.CustLevel.IsSuperLevel())
                    {
                        <td>@HtmlHelpers.FormatNumber((int)Math.Round(w.SuperPercent))</td>
                        <td>@HtmlHelpers.FormatNumber((int)Math.Round(w.CompanyPercent))</td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@Model.NoOfColumns">@BetListsResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>