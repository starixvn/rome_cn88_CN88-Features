@model StartedWagerByAccountViewModel
@{
    ViewBag.Title = BetListsResources.WagerDetails;
    Layout = "~/Shared/Views/_Layout.cshtml";
    var backLink = Model.BuildBackLink(Request.Url.Query);
}

@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/betlist-of-report")
}
<div class="betlist-container betlist-by-account">
    <div class="page-title">@BetListsResources.WagerDetails</div>
    <ul id="nav-tabs" class="nav nav-tabs-style2" role="tablist">
        <li class="lnk-changetab active" role="presentation">
            <a>@BetListsResources.ViewByAccount</a>
        </li>
        <li id="lnk-wager-details" class="lnk-changetab" role="presentation" data-url="@Model.WagerDetailsLink()">
            <a>@BetListsResources.ViewWagerDetails</a>
        </li>
    </ul>
    @if (Model.IsMobile)
    {
        @Html.Partial("~/BetLists/Views/BackLinkMobile.cshtml", backLink)
        @Html.Partial("~/BetLists/Views/BetListTableMobile.cshtml", Model)
    }
    else
    {
        @BetLists.TotalBetBreadcrumb.Render(Model.BreadcrumbLevelViewModel, Request.Url.Query, Model.BreadcrumbParamByLevel)
        @Html.Partial("~/BetLists/Views/BetListTable.cshtml", Model)
        @Pager.Render(Model.PagerViewModel)
    }
</div>

@Html.Hidden("betlist-path", HttpContext.Current.Response.ApplyAppPathModifier("~/"))
@Html.Hidden("old-main-path", Model.OldMainPath)
@Html.Hidden("results-path", Model.ResultsPath)
@Html.Hidden("totalbets-forecast-path", Model.TotalBetsForecastPath)
@Html.Hidden("cust-id", Model.CustId)
@Html.Hidden("viewer-id", Model.ViewerIdOrViewerAdminId)
@Html.Hidden("viewer-level-id", Model.ViewerLevelId)
@Html.Hidden("cust-id", Model.CustId)
@Html.Hidden("colossusBets-PopUpDetail-Title", BetListsResources.ColossusBetsPopUpDetailTitle)
@Html.Hidden("isMobile", Model.IsMobile)

@section Scripts{
    @StaticResources.RenderScripts("~/BetLists/bundles/wager-by-account")
}
