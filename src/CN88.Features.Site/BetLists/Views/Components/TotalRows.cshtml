@model BetListViewModelBase
@if (Model.BetListData.HasData())
{
    var total = Model.BetListTotal;

    if (Model.IsMobile)
    {
        <tr class="total">
            <th>@BetListsResources.Total: @Model.BetListData.TotalText</th>
            <th class="@Model.GetTotalClass() text-right stake-block">@Html.Raw(total.TotalStakeStr)</th>
            @if (Model.IsShowWinLoss)
            {
                if (Model.IsAllInvalidTicket())
                {
                    <th class="text-right @Model.GetTotalClass()"><div class="col-winloss">-</div></th>
                }
                else
                {
                    <th class="text-right winloss">@Html.Raw(total.TotalWinLossStr)</th>
                }
            }
            @if (Model.IsShowPayout)
            {
                <th class="text-right">@Model.TotalPayoutText</th>
            }
        </tr>

        if (!Model.IsShowPayout && Model.IsShowWinLoss)
        {
            <tr class="winloss-comm @Model.GetTotalClass()">
                <th colspan="@Model.TotalColColspan">@BetListsResources.WinLossWithCommission</th>
                <th class="text-right col-winloss">@Html.Raw(Model.IsAllInvalidTicket() ? "-" : total.TotalStr)</th>
            </tr>
        }
    }
    else
    {
        if (Model.IsShowPayout)
        {
            <tr class="total @Model.GetTotalClass()">
                <th colspan="3">@BetListsResources.Total</th>
                <th>@Model.BetListData.TotalText</th>
                <th class="text-right stake-block">@(new HtmlString(Model.BetListTotal.TotalStakeStr))</th>
                <th class="text-right">@(new HtmlString(Model.TotalPayoutText))</th>
                <th colspan="@(Model.NoOfColumns - 6)"></th>
            </tr>
        }
        else
        {
            <tr class="total">
                <th colspan="3">@BetListsResources.Total</th>
                <th>@Model.BetListData.TotalText</th>
                <th class="@Model.GetTotalClass() text-right stake-block">@(Html.Raw(total.TotalStakeStr))</th>
                @if (Model.IsShowWinLoss)
                {
                    if (Model.IsAllInvalidTicket())
                    {
                        <th class="@Model.GetTotalClass() text-right"><div class="col-winloss">-</div></th>
                    }
                    else
                    {
                        <th class="text-right winloss">@Html.Raw(total.TotalWinLossStr)</th>
                    }
                }
                <th colspan="@(Model.NoOfColumns - 6 + (Model.IsShowWinLoss ? 0 : 1))"></th>
            </tr>
            if (Model.IsShowWinLoss)
            {
                <tr class="winloss-comm @Model.GetTotalClass()">
                    <th colspan="5" mobile-colspan="2">@BetListsResources.WinLossWithCommission</th>
                    <th class="text-right col-winloss">@Html.Raw(Model.IsAllInvalidTicket() ? "-" : total.TotalStr)</th>
                    <th colspan="@(Model.NoOfColumns - 6)"></th>
                </tr>
            }
        }
    }
}
