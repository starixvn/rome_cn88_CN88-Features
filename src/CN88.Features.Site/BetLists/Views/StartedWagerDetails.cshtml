@using Alpha.Web.Helpers
@model StartedWagerDetailsViewModel
@{
    ViewBag.Title = BetListsResources.WagerDetails;
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/betlist-of-report")
}
<div class="new-page-header">@BetListsResources.WagerDetails</div>

<div class="betlist-container betlist-wager-details">
    <div class="page-title">@BetListsResources.WagerDetails</div>
    <ul id="nav-tabs" class="nav @(Model.IsMobile ? "nav-tabs" : "nav-tabs-style2")" role="tablist">
        <li id="lnk-bet-list-by-account" class="lnk-changetab " role="presentation" data-url="@Model.WagerByAccountLink()">
            <a>@BetListsResources.ViewByAccount</a>
        </li>
        <li class="lnk-changetab active" role="presentation">
            <a>@BetListsResources.ViewWagerDetails</a>
        </li>
    </ul>
    @if (Model.IsMobile)
    {
        @Html.Partial("~/BetLists/Views/BetListTableMobile.cshtml", Model)
    }
    else
    {
        @Html.Partial("~/BetLists/Views/BetListTable.cshtml", Model)
        @Pager.Render(Model.PagerViewModel)
    }
</div>

@Html.Partial("~/BetLists/Views/Components/HiddenFields.cshtml")

@section Scripts{
    @StaticResources.RenderScripts("~/BetLists/bundles/wager-details")
}