@using CN88.Features.Shared.AppResources
@model BetListOfReportViewModel
@{
    var reportFilter = Model.ReportFilterViewModel;
}
<form class="form-inline filter report-form" role="form" id="report-form"
      @Html.Raw(Model.IsMobile ? " style=\"display:none;\"" : string.Empty)>
    @RenderHiddenFields()
    @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelViewModel.BreadcrumbLevelJson)
    @SportGroupSelection.Render(reportFilter.SportGroupSelectionViewModel, true)
    @DateRangePicker.Render(reportFilter.DateRangePickerViewModel)
    @BetTypeSelection.Render(reportFilter.BetTypeSelectionViewModel, true)
    @LiveStatusSelection.Render(reportFilter.LiveStatusSelectionViewModel, true)
    <div class="form-group">
        <input type="submit" value="@SharedResources.Submit" class="btn-submit" />
    </div>
</form>
<form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("BetListOfReportExcel","BetLists")">
    @RenderHiddenFields()
    @Html.Hidden("FromDate", Model.ReportFilterViewModel.DateRangePickerViewModel.FromDate)
    @Html.Hidden("ToDate", Model.ReportFilterViewModel.DateRangePickerViewModel.ToDate)
    @Html.Hidden("UserSelectedSportGroupId", Model.ReportFilterViewModel.SportGroupSelectionViewModel.UserSelectedId)
    @Html.Hidden("UserSelectedBetTypeId", Model.ReportFilterViewModel.BetTypeSelectionViewModel.UserSelectedId)
    @Html.Hidden("UserSelectedLiveStatusId", Model.ReportFilterViewModel.LiveStatusSelectionViewModel.UserSelectedId)
</form>
@helper RenderHiddenFields()
{
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.ReportFilterViewModel.CustName)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("IsOwner", Model.ReportFilterViewModel.IsOwner)
    @Html.Hidden("ReportType", Model.ReportType)
    @Html.Hidden("DisplayMode", Model.DisplayMode)
    @Html.Hidden("ReportMainActionPath", Model.ReportMainActionPath)
    @Html.Hidden("IsOldReport", Model.IsOldReport)
    @Html.Hidden("Type", Model.Type)
}