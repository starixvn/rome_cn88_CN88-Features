@using CN88.Features.Site.BetLists.Helpers
@model BetListViewModelBase
<table id="tbl-report" class="tbl-noborder tbl-betlists">
    <thead>
        <tr>
            <th class="text-left">@BetListsResources.DateTime</th>
            <th class="text-left">@BetListsResources.Member/<br />@BetListsResources.Commission</th>
            <th class="text-left">@BetListsResources.BetID/<br />@BetListsResources.BetType</th>
            <th class="text-left">@BetListsResources.Details</th>
            <th class="text-right">@BetListsResources.Stake</th>
            @if (Model.IsShowWinLoss)
            {
                <th class="text-right">@BetListsResources.WinLoss</th>
                <th class="text-center">@BetListsResources.Status</th>
            }
            @Html.Partial("~/BetLists/Views/Components/PayoutColumn.cshtml")
            @Html.Partial("~/BetLists/Views/Components/PossessColumns.cshtml")
        </tr>
        @Html.Partial("~/BetLists/Views/Components/TotalRows.cshtml")
    </thead>
    <tbody>
        @if (Model.BetListData.HasData())
        {
            var tickets = Model.BetListData.Tickets.ToList();

            for (int i = 0; i < tickets.Count; i++)
            {
                var ticket = tickets[i];
                <tr data-trans-id="@ticket.TransId" class="@BetListHelpers.TicketRowClass(ticket)">
                    @BetListHelper.RenderTransDate(ticket)
                    @BetListHelper.RenderComm(ticket)
                    @BetListHelper.RenderBetID(ticket, Model.CN88Builder, Model.TicketHelper, Model.TicketHelper.GetOddsTypeNameById)
                    @BetListHelper.RenderDetail(ticket, Model.CN88Builder, Model.TicketHelper, Model.BetListData.TicketData)
                    @BetListHelper.RenderStake(ticket, Model.Divisor)
                    @if (Model.IsShowWinLoss)
                    {
                        @BetListHelper.RenderWinLoss(ticket, Model.Divisor)
                        @BetListHelper.RenderStatus(ticket, Model.Builder, Model.TicketHelper, Model.BetListData.TicketData, Model.DisplayVNIP)
                    }
                    @Html.Partial("~/BetLists/Views/Components/PayoutColumn.cshtml", Model, new ViewDataDictionary
                    {
                        { "IsBody", true },
                        { "Ticket", ticket }
                    })
                    @Html.Partial("~/BetLists/Views/Components/PossessColumns.cshtml", Model, new ViewDataDictionary
                    {
                        { "Ticket", ticket }
                    })
                </tr>
            }
        }
        else
        {
            @BetListHelper.RenderNoInformation(Model.NoOfColumns)
        }
    </tbody>
</table>
