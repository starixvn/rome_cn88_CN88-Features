@using CN88.Features.Shared.AppResources
@model TotalBetParlayViewModel
@{
    ViewBag.Title = SharedResources.ParlayText;
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/betlist-of-report")
}
<div class="totalbet-parlay-title">
    <span class="icon-filter-down" id="filter-toggle-icon"></span>
</div>
<div class="betlist-container total-bet-parlay">
    <form class="form-inline filter report-form" role="form" id="report-form">
        @Html.Hidden("CustId", Model.CustId)
        @Html.Hidden("SportGroupId", Model.SportGroupId)

        @SportGroupSelection.Render(Model.SportGroupSelectionViewModel, true)
        @StakeSelection.Render(Model.StakeSelectionViewModel, true)
        @ViewModeSelection.Render(Model.ViewModeSelectionViewModel, true)
        <div class="form-group">
            <input type="submit" value="@SharedResources.Submit" class="btn-submit" />
        </div>
    </form>
    <div id="totalbet-parlay-report">
        @if (Model.IsMobile)
        {
            @Html.Partial("~/BetLists/Views/BetListTableMobile.cshtml", Model)
        }
        else
        {
            @Html.Partial("~/BetLists/Views/BetListTable.cshtml", Model)
            @Pager.Render(Model.PagerViewModel)
        }
    </div>
</div>

@Html.Partial("~/BetLists/Views/Components/HiddenFields.cshtml")

@section Scripts{
    @StaticResources.RenderScripts("~/BetLists/bundles/total-bet-parlay")
}