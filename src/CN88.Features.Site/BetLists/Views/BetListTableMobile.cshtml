@using CN88.Features.Site.BetLists.Helpers
@using CN88.Features.BetLists.Models
@using CN88.Features.BetLists.Helpers
@using Fanex.BetList.Core.Utils
@using CN88.Features.Extensions

@model BetListViewModelBase
@{
    var builder = Model.CN88Builder;
    var mbcBuilder = Model.Builder;
    var helper = Model.TicketHelper;
    var ticketData = Model.BetListData.TicketData;
    var divisor = Model.Divisor;
}
<table id="tbl-report"
       class="tbl-noborder tbl-betlists"
       data-ismobile="@Model.IsMobile.ToString().ToLower()">
    <thead>
        <tr>
            <th class="text-left col-details">@BetListsResources.Details</th>
            <th class="text-right">@BetListsResources.Stake</th>

            @if (Model.IsShowWinLoss)
            {
                <th class="text-right">@BetListsResources.WinLoss</th>
            }

            @Html.Partial("~/BetLists/Views/Components/PayoutColumn.cshtml")
            @Html.Partial("~/BetLists/Views/Components/PossessColumns.cshtml")

        </tr>
        @RenderHeaderTotalRow()
    </thead>
    <tbody>
        @if (Model.BetListData.HasData())
        {
            var tickets = Model.BetListData.Tickets.ToList();

            for (int i = 0; i < tickets.Count; i++)
            {
                var ticket = tickets[i];
        <tr data-trans-id="@ticket.TransId">
            <td>
                @RenderDetailColumn(ticket)
            </td>

            @BetListHelper.RenderStake(ticket, Model.Divisor)

            @if (Model.IsShowWinLoss)
            {
            <td class="text-right">
                @BetListHelper.RenderWinLoss(ticket, divisor, true)
                <br />
                @BetListHelper.RenderStatus(ticket, mbcBuilder, helper, ticketData, Model.DisplayVNIP, true)
            </td>
            }

            @Html.Partial("~/BetLists/Views/Components/PayoutColumn.cshtml", Model, new ViewDataDictionary
            {
                { "IsBody", true },
                { "Ticket", ticket }
            })

            @Html.Partial("~/BetLists/Views/Components/PossessColumns.cshtml", Model, new ViewDataDictionary
            {
                { "Ticket", ticket }
            })
        </tr>
            }
        }
        else
        {
            @BetListHelper.RenderNoInformation(Model.NoOfColumns)
        }
    </tbody>
</table>

@helper RenderBetListTotal(string winLoss, string stake, string total)
{
    <tr class="total">
        <th>@BetListsResources.Total: @Model.BetListData.Total.ToString("#,##0")</th>
        <th class="text-right">@Html.Raw(stake)</th>

        @if (Model.IsShowWinLoss)
        {
            <th class="text-right winloss">@Html.Raw(winLoss)</th>
        }

        @if (Model.IsShowPayout)
        {
            <th class="text-right">@Model.TotalPayoutText</th>
        }
    </tr>

    if (!Model.IsShowPayout && Model.IsShowWinLoss)
    {
        <tr class="winloss-comm">
            <th colspan="@Model.TotalColColspan">@BetListsResources.WinLossWithCommission</th>
            <th class="text-right">@Html.Raw(total)</th>
        </tr>
    }
}

@helper RenderDetailColumn(TicketDto ticket)
{
        <div class="detail-container">
            @BetListHelper.RenderTransDate(ticket, true)
            <br />
            @ticket.UserName
            @BetListHelper.RenderComm(ticket, true)
            @(new HtmlString(Model.CN88Builder.BuildBetInfo(ticket, Model.TicketHelper, (obj) => Model.TicketHelper.GetOddsTypeNameById(ConvertByBetType.OddsType(ticket.BetTypeId, ticket.OddsType)))))
            @(new HtmlString(Model.CN88Builder.BuildChoice(ticket, Model.TicketHelper, Model.BetListData.TicketData)))
        </div>
}

@helper RenderHeaderTotalRow()
{
    if (Model.BetListData.HasData())
    {
        var total = Model.BetListTotal;

        @RenderBetListTotal(total.TotalWinLossStr, total.TotalStakeStr, total.TotalStr)
    }
}