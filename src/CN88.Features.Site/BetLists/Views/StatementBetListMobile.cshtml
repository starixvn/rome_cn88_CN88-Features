@using CN88.Features.Extensions
@model BetListOfStatementViewModel
@{
    ViewBag.Title = BetListsResources.BetList;
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/betlist-of-report")
}

<div class="betlist-container betlist-statement">
    <div class="page-title-mobile btn-back back-area">
        <span class="icon-chevron-left  back-step"></span>
        @BetListsResources.Statement | @Model.Date.ToLongDay()
    </div>
    <div class="username">@Model.CustName</div>
    @Html.Partial("~/BetLists/Views/BetListTableMobile.cshtml", Model)
</div>

@Html.Partial("~/BetLists/Views/Components/Popup.cshtml")
@Html.Partial("~/BetLists/Views/Components/HiddenFields.cshtml")
@Html.Hidden("from-date", Model.Date)

@section Scripts{
    @StaticResources.RenderScripts("~/BetLists/bundles/betlist-of-statement")
}