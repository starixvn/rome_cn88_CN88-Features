@using CN88.Features.Shared.Configurations
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes">
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-features/default")
    @StaticResources.RenderStyles("~/BetLists/bundles/wager-monitoring/styles")
</head>
<body @Html.Raw(CN88.Web.Helpers.BrowserManager.BuildMobileHtmlClass())>
    <div class="betlist-container wager-monitoring">
        <table></table>
    </div>
    @Html.Partial("~/BetLists/Views/Components/Popup.cshtml")
    @Html.Hidden("betlist-path", HttpContext.Current.Response.ApplyAppPathModifier("~/"))
    @Html.Hidden("results-path", AppPathHelper.GetAppPath(AppSettings.ResultAppPath, "~"))
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-features/default")
    @StaticResources.RenderScripts("~/BetLists/bundles/betlist")
    @StaticResources.RenderScripts("~/BetLists/bundles/wager-monitoring/pause")
    @*@Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())*@
</body>
</html>