@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@using Fanex.BetList.Core.Entities
@using CN88.Features.Site.BetLists.ViewModels.WagerMonitoring
@model WagerMonitoringViewModel
@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/wager-monitoring")
}
<div class="betlist-container wager-monitoring">
    <div class="function-group">
        <div class="btn-function"><span class="icon-delete"></span>@SharedResources.Clear</div>
        <div class="btn-function"><span class="icon-pause"></span>@SharedResources.Pause</div>
        <div class="btn-function"><span class="icon-audio-speaker icon-audio-speaker-on"></span><span id="icon-audio-text">@SharedResources.On</span></div>
        <audio controls="controls" class="hide" id="sound">
            <source src="../BetLists/bundles/TPBTLOW.ogg" type="audio/ogg" />
        </audio>
    </div>
    <div class="page-title">
        @BetListsResources.WagerMonitoringConsole
    </div>
    <div class="dropdown-sportgroup">
        @SportGroupSelection.Render(Model.SportGroupSelectionViewModel, false)
    </div>
    @Html.Partial("~/BetLists/Views/WagerMonitoring/FilterForm.cshtml", Model.FilterFormViewModel)
    <table id="tbl-betlist" class="tbl-noborder tbl-betlists">
        <thead>
            <tr>
                <th class="text-left">@BetListsResources.DateTime</th>
                <th class="text-left">@BetListsResources.Member/<br />@BetListsResources.Commission</th>
                <th class="text-left">@BetListsResources.BetID/<br />@BetListsResources.BetType</th>
                <th class="text-left">@BetListsResources.Details</th>
                <th class="text-right">@BetListsResources.Stake</th>
                @if (Model.CustLevel.IsAgentLevel())
                {
                    <th class="text-right">@BetListsResources.AgentPercent</th>
                }
                @if (Model.CustLevel.IsMasterLevel())
                {
                    <th class="text-right">@BetListsResources.AgentPercent</th>
                    <th class="text-right">@BetListsResources.MAPercent</th>
                }
                @if (Model.CustLevel.IsSuperLevel() || Model.CustLevel.IsHeadline())
                {
                    <th class="text-right">@BetListsResources.AgentPercent</th>
                    <th class="text-right">@BetListsResources.MAPercent</th>
                    <th class="text-right">@BetListsResources.SMAPercent</th>
                    <th class="text-right">@BetListsResources.CoPercent</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Tickets.Any())
            {
                foreach (var ticket in Model.Tickets)
                {
                    <tr data-trans-id="@ticket.TransId">
                        @BetLists.TransDate.Render(ticket)
                        @BetLists.Comm.Render(ticket)
                        @BetLists.BetID.Render(ticket, Model.CN88Builder, Model.TicketHelper, Model.TicketHelper.GetOddsTypeNameById)
                        @BetLists.Details.Render(ticket, Model.CN88Builder, Model.TicketHelper, new List<ITicketData>())
                        @BetLists.Stake.Render(ticket, Model.Divisor)
                        @if (Model.CustLevel.IsAgentLevel())
                        {
                            @HtmlHelpers.RenderNumberCell((int)(ticket.AgentPositionTaking * 100), "text-right")
                        }
                        @if (Model.CustLevel.IsMasterLevel())
                        {
                            @HtmlHelpers.RenderNumberCell((int)(ticket.AgentPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(ticket.MasterPositionTaking * 100), "text-right")
                        }
                        @if (Model.CustLevel.IsSuperLevel() || Model.CustLevel.IsHeadline())
                        {
                            @HtmlHelpers.RenderNumberCell((int)(ticket.AgentPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(ticket.MasterPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(ticket.SuperPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(ticket.CompanyPositionTaking() * 100), "text-right")
                        }
                    </tr>
                }
            }
            else
            {
                @BetLists.NoInfomation.Render(Model.NoOfColumns)
            }
        </tbody>
    </table>
</div>
<div class="modal fade filter-modal" id="filter-modal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
</div>
@Html.Hidden(nameof(Model.MinTransId), Model.MinTransId)
@Html.Hidden(nameof(Model.PageSize), Model.PageSize)
@Html.Hidden(nameof(Model.IntervalTime), Model.IntervalTime)
@Html.Hidden(nameof(Model.FilterModalPath), Model.FilterModalPath)
@Html.Hidden(nameof(Model.WagerMonitoringPath), Model.WagerMonitoringPath)
@Html.Hidden("pause-url", Url.Action("Pause", "WagerMonitoring"))
@Html.Hidden("get-bets-url", Url.Action("LastBets", "WagerMonitoring"))

@Html.Hidden("lbl-PerSports", SharedResources.PerSports)
@Html.Hidden("lbl-StakeMode_0", SharedResources.StakeMode_0)
@Html.Hidden("lbl-StakeMode_1", SharedResources.StakeMode_1)
@Html.Hidden("lbl-StakeMode_2", SharedResources.StakeMode_2)
@Html.Hidden("lbl-StakeMode_3", SharedResources.StakeMode_3)
@Html.Hidden("lbl-StakeMode_4", SharedResources.StakeMode_4)
@Html.Hidden("lbl-Markets", WagerMonitoringMarket.Markets)
@Html.Hidden("lbl-AllMarkets", SharedResources.AllMarkets)
@Html.Hidden("lbl-League", BetListsResources.League)
@Html.Hidden("lbl-AllLeagues", BetListsResources.AllLeagues)
@Html.Hidden("lbl-Event", BetListsResources.Event)
@Html.Hidden("lbl-AllEvents", BetListsResources.AllEvents)
@Html.Hidden("lbl-BetType", SharedResources.BetType)
@Html.Hidden("lbl-AllBetTypes", SharedResources.AllBetTypes)
@Html.Hidden("lbl-On",SharedResources.On)
@Html.Hidden("lbl-Off", SharedResources.Off)

@section Scripts{
    @StaticResources.RenderScripts("~/BetLists/bundles/betlist")
    @StaticResources.RenderScripts("~/BetLists/bundles/wager-monitoring")
}