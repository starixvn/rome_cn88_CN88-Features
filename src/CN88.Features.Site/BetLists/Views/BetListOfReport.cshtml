@model BetListOfReportViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}

<div class="page-title">@BetListsResources.BetList</div>
<table class="tbl-style2">
    <thead>
        <tr>
            <th>@BetListsResources.DateTime</th>
            <th>@BetListsResources.Member/@BetListsResources.Commission</th>
            <th>@BetListsResources.BetID/<br />@BetListsResources.BetType</th>
            <th>@BetListsResources.Details</th>
            <th>@BetListsResources.Stake</th>
            <th>@BetListsResources.WinLoss</th>
            <th>@BetListsResources.Status</th>
            <th>@BetListsResources.AgentPercent</th>

            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th>@BetListsResources.MAPercent</th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th>@BetListsResources.SMAPercent</th>
                <th>@BetListsResources.CoPercent</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (!Model.BetListData.Tickets.Any())
        {
            var total = Model.BetListTotal;

            @BetLists.BetListTotal.Render(total.TotalWinLossStr, total.TotalStakeStr, total.TotalStr, Model.BetListData.Total, Model.NoOfColumns)
            for (int i = 0; i < Model.BetListData.Total; i++)
            {
                var ticket = Model.BetListData.Tickets.ElementAt(i);
            }
        }
        else
        {
            @BetLists.NoInfomation.Render(Model.NoOfColumns)
        }
    </tbody>
</table>