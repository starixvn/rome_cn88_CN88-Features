@using Fanex.BetList.Core.Utils
@model BetListOfReportViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/betlist-of-report")
}
<div class="page-title">@BetListsResources.BetList</div>
<table class="tbl-style2">
    <thead>
        <tr>
            <th>@BetListsResources.DateTime</th>
            <th>@BetListsResources.Member/@BetListsResources.Commission</th>
            <th>@BetListsResources.BetID/<br />@BetListsResources.BetType</th>
            <th>@BetListsResources.Details</th>
            <th>@BetListsResources.Stake</th>
            <th>@BetListsResources.WinLoss</th>
            <th>@BetListsResources.Status</th>
            <th>@BetListsResources.AgentPercent</th>

            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th>@BetListsResources.MAPercent</th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th>@BetListsResources.SMAPercent</th>
                <th>@BetListsResources.CoPercent</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (!Model.BetListData.Tickets.Any())
        {
            var total = Model.BetListTotal;

            @BetLists.BetListTotal.Render(total.TotalWinLossStr, total.TotalStakeStr, total.TotalStr, Model.BetListData.Total, Model.NoOfColumns)
            for (int i = 0; i < Model.BetListData.Total; i++)
            {
                var ticket1 = Model.BetListData.Tickets.ElementAt(i);
            }

            var ticket = CN88.Features.BetLists.DataAccesses.BetListsDataSample.Ticket1();
            <tr>
                @BetLists.TransDate.Render(ticket)
                @BetLists.Comm.Render(ticket)
                @BetLists.BetID.Render(ticket, Model.CN88Builder, Model.TicketHelper, Model.TicketHelper.GetOddsTypeNameById)
                @BetLists.Details.Render(ticket, Model.CN88Builder, Model.TicketHelper, Model.BetListData.TicketData)
                <td>@Html.Raw(ConvertByBetType.Stake(ticket.Stake))</td>
                <td>@Html.Raw(ConvertByBetType.Winloss(ticket.Winlost))</td>
                @BetLists.Status.Render(ticket, Model.Builder, Model.TicketHelper, Model.BetListData.TicketData, Model.DisplayVNIP)
                @HtmlHelpers.RenderNumberCell((int)ticket.AgentPositionTaking)
                @if (Model.CustLevel.IsMasterOrSuperLevel())
                {
                    @HtmlHelpers.RenderNumberCell((int)ticket.MasterPositionTaking)
                }

                @if (Model.CustLevel.IsSuperLevel())
                {
                    @HtmlHelpers.RenderNumberCell((int)ticket.SuperPositionTaking)
                    @HtmlHelpers.RenderNumberCell((int)Model.CompanyPositionTaking(ticket))
                }
            </tr>
        }
        else
        {
            @BetLists.NoInfomation.Render(Model.NoOfColumns)
        }
    </tbody>
</table>
@section Scripts{
    @StaticResources.RenderScripts("~/BetLists/bundles/betlist-of-report")
}