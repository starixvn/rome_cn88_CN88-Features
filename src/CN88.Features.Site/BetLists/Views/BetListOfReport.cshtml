@model BetListOfReportViewModel
@{
    ViewBag.Title = "Bet List";
    Layout = Model.IsOldReport ? "~/Reports/Views/_OldLayout.cshtml" : "~/Shared/Views/_Layout.cshtml";

    var isSettlement = string.IsNullOrWhiteSpace(Request["IsSettlement"]) || string.Equals(Request["IsSettlement"], bool.TrueString, StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/betlist-of-report")
}
<div class="betlist-container">
    <div class="page-title title-report-detail">
        <span class="report-name">@Model.ReportTitle</span>
        @Breadcrumb.Render(Model.BreadcrumbLevelViewModel, Request.Url.Query, Model.BreadcrumbParamByLevel, Model.issh)
    </div>
    @Html.Partial("~/BetLists/Views/Filter.cshtml")
    @Html.Partial("~/BetLists/Views/BetListTable.cshtml")
    @Pager.Render(Model.PagerViewModel)
</div>

@if (Model.IsOldReport)
{
    @Html.Partial("~/BetLists/Views/Components/Popup.cshtml")
}

@Html.Partial("~/BetLists/Views/Components/HiddenFields.cshtml")

@Html.Hidden("from-date", Model.FromDate)
@Html.Hidden("to-date", Model.ToDate)
@Html.Hidden("bet-list-type", Model.Type)

@section Scripts {
    @StaticResources.RenderScripts("~/BetLists/bundles/betlist-of-report")
    @if (Model.IsOldReport)
    {
        @StaticResources.RenderScripts("~/BetLists/bundles/betlist-of-report-old")
    }

    <script>
        var betTypes = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReportFilterViewModel.AllBetTypeGroups.GroupBy(i => i.SportTypeGroup)));
    </script>
}
