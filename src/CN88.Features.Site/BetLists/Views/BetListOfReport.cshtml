@using Fanex.BetList.Core.Utils
@model BetListOfReportViewModel
@{
    ViewBag.Title = "Bet List";
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/BetLists/bundles/betlist-of-report")
}
<div class="betlist-container">

    <div class="page-title title-report-detail">
        <span class="report-name">@Model.ReportTitle</span>
        @Breadcrumb.Render(Model.BreadcrumbLevelViewModel, Request.Url.Query, null)
    </div>
    @Html.Partial("~/BetLists/Views/Filter.cshtml", Model)
    <table class="tbl-noborder tbl-betlists">
        <thead>
            <tr>
                <th class="tex-left">@BetListsResources.DateTime</th>
                <th class="tex-left">@BetListsResources.Member/@BetListsResources.Commission</th>
                <th class="tex-left">@BetListsResources.BetID/<br />@BetListsResources.BetType</th>
                <th class="tex-left">@BetListsResources.Details</th>
                <th class="tex-right">@BetListsResources.Stake</th>
                <th class="tex-right">@BetListsResources.WinLoss</th>
                <th class="tex-center">@BetListsResources.Status</th>

                @if (Model.CustLevel.IsAgentLevel())
                {
                    <th class="tex-right">@BetListsResources.AgentPercent</th>
                }

                @if (Model.CustLevel.IsMasterLevel())
                {
                    <th class="tex-right">@BetListsResources.AgentPercent</th>
                    <th class="tex-right">@BetListsResources.MAPercent</th>
                }

                @if (Model.CustLevel.IsSuperLevel() || Model.CustLevel.IsHeadline())
                {
                    <th class="tex-right">@BetListsResources.AgentPercent</th>
                    <th class="tex-right">@BetListsResources.MAPercent</th>
                    <th class="tex-right">@BetListsResources.SMAPercent</th>
                    <th class="tex-right">@BetListsResources.CoPercent</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.BetListData.Tickets.Any())
            {
                var total = Model.BetListTotal;

                @BetLists.BetListTotal.Render(total.TotalWinLossStr, total.TotalStakeStr, total.TotalStr, Model.BetListData.Total, Model.NoOfColumns)

                var tickets = Model.BetListData.Tickets.ToList();

                for (int i = 0; i < tickets.Count; i++)
                {
                    var ticket = tickets[i];
                    <tr data-trans-id="@ticket.TransId">
                        @BetLists.TransDate.Render(ticket)
                        @BetLists.Comm.Render(ticket)
                        @BetLists.BetID.Render(ticket, Model.CN88Builder, Model.TicketHelper, Model.TicketHelper.GetOddsTypeNameById)
                        @BetLists.Details.Render(ticket, Model.CN88Builder, Model.TicketHelper, Model.BetListData.TicketData)
                        <td class="text-right">@Html.Raw(ConvertByBetType.Stake(ticket.Stake / Model.Divisor))</td>
                        <td class="text-right">@Html.Raw(ConvertByBetType.Winloss(ticket.Winlost / Model.Divisor))</td>
                        @BetLists.Status.Render(ticket, Model.Builder, Model.TicketHelper, Model.BetListData.TicketData, Model.DisplayVNIP)

                        @if (Model.CustLevel.IsAgentLevel())
                        {
                            @HtmlHelpers.RenderNumberCell((int)(ticket.AgentPositionTaking * 100), "text-right")
                        }

                        @if (Model.CustLevel.IsMasterLevel())
                        {
                            @HtmlHelpers.RenderNumberCell((int)(ticket.AgentPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(ticket.MasterPositionTaking * 100), "text-right")
                        }

                        @if (Model.CustLevel.IsSuperLevel() || Model.CustLevel.IsHeadline())
                        {
                            @HtmlHelpers.RenderNumberCell((int)(ticket.AgentPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(ticket.MasterPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(ticket.SuperPositionTaking * 100), "text-right")
                            @HtmlHelpers.RenderNumberCell((int)(Model.CompanyPositionTaking(ticket) * 100), "text-right")
                        }
                    </tr>
                }
            }
            else
            {
                @BetLists.NoInfomation.Render(Model.NoOfColumns)
            }
        </tbody>
    </table>
    @Pager.Render(Model.PagerViewModel)
</div>


@Html.Hidden("betlist-path", HttpContext.Current.Response.ApplyAppPathModifier("~/"))
@Html.Hidden("old-main-path", Model.OldMainPath)
@Html.Hidden("results-path", Model.ResultsPath)
@Html.Hidden("totalbets-forecast-path", Model.TotalBetsForecastPath)
@Html.Hidden("sport-type-group", Model.SportTypeGroup)
@Html.Hidden("bet-type-group", Model.BetTypeGroup)
@Html.Hidden("from-date", Model.FromDate)
@Html.Hidden("to-date", Model.ToDate)
@Html.Hidden("cust-id", Model.CustId)
@Html.Hidden("viewer-id", Model.ViewerIdOrViewerAdminId)
@Html.Hidden("viewer-level-id", Model.ViewerLevelId)
@Html.Hidden("cust-id", Model.CustId)
@Html.Hidden("bet-list-type", Model.Type)
@Html.Hidden("colossusBets-PopUpDetail-Title", BetListsResources.ColossusBetsPopUpDetailTitle)

@section Scripts{
    @StaticResources.RenderScripts("~/BetLists/bundles/betlist-of-report")
}
