@using CN88.Features.Extensions
@using System.Linq
@model ParlaySubTicketsViewModel
@{
    Layout = null;
}
@if (Model.HasValidData)
{
    foreach (var unitStakeByOfferNames in Model.UnitStakeByOfferNames)
    {
        <div class="offer-name-list">
            @unitStakeByOfferNames.Key x <span class="unit-stake">@unitStakeByOfferNames.Value</span>
        </div>
    }

    <div class="line"></div>

    foreach (var ticket in Model.BetListData.Tickets)
    {
        <div class="ticket-list">
            <div class="group-sport-bet-types">
                <span class="sport-type">@Model.GetSportName(ticket.SportTypeId)</span>
                <span class="bet-type">@Model.CN88Builder.CreateBetInfoBuilder(ticket.BetTypeId).RenderBetTypeName(ticket, Model.TicketHelper)</span>
            </div>
            @(new HtmlString(Model.CN88Builder.BuildChoice(ticket, Model.TicketHelper, null)))
            <div class="event-date">@ticket.EventDate.ToGlobalShowtime()</div>
            @Html.Raw(Model.Builder.CreateStatusBuilder(ticket.BetTypeId).RenderStatusResultText(ticket, null))
        </div>

        if (!ticket.Equals(Model.BetListData.Tickets.Last()))
        {
            <div class="line"></div>
        }
    }
}
else
{
    @BetListsResources.NoInformationIsAvailable
}
