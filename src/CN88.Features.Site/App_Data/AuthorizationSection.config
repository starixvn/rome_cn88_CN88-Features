<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid,CustomerId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer,setting"
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <!--<add id="1.01.01" permission="[E]" mainfuncname="Report" subfuncname="Main Report" url="Reports/Index" ischeckbelonging="true" isallowtodobythemselves="true" />-->
      <add id="1.03.01" permission="[H]" mainfuncname="Account Management" subfuncname="Downline List" url="CustomerList/GetCustomerList" ischeckbelonging="true" />
      <add id="1.03.02" permission="[H]" mainfuncname="Account Management" subfuncname="Member Statement" url="CustomerList/MemberStatement" ischeckbelonging="true" />
      <add id="1.03.03" permission="[H]" mainfuncname="Account Management" subfuncname="Credit" url="CustomerList/CreditPopup" ischeckbelonging="true" />
      <add id="1.03.04" permission="[H]" mainfuncname="Account Management" subfuncname="Credit Update" url="CustomerList/UpdateCredit" ischeckbelonging="true" />
      <add id="1.03.05" permission="[H]" mainfuncname="Account Management" subfuncname="Customer Status" url="CustomerList/StatusPopup" ischeckbelonging="true" />
      <add id="1.03.06" permission="[H]" mainfuncname="Account Management" subfuncname="Customer Status Update" url="CustomerList/UpdateCustomerStatus" ischeckbelonging="true" />
      <add id="1.03.07" permission="[H]" mainfuncname="Account Management" subfuncname="Customer Setting" url="CN88CustomerSetting/ViewCN88CustomerSetting/Edit" ischeckbelonging="true" />
      <add id="1.03.08" permission="[H]" mainfuncname="Account Management" subfuncname="Customer Setting Update" url="CN88CustomerSetting/UpdateCN88CustomerSetting/Update" ischeckbelonging="true" />
      <add id="1.03.09" permission="[H]" mainfuncname="Account Management" subfuncname="Customer Setting View New" url="CN88CustomerSetting/ViewCN88CustomerSetting/Create" ischeckbelonging="true" />
      <add id="1.03.10" permission="[H]" mainfuncname="Account Management" subfuncname="Customer Setting Create" url="CN88CustomerSetting/CreateCN88Customer/Create" ischeckbelonging="true" />

      <add id="1.04.11" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/BetListOfReport" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.04.12" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/BetListOfStatement" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.13" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/ParlaySubTickets" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.14" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/ParlayDetail" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.15" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/ParlayDetailExcel" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.16" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/BetListOfReportExcel" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.17" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/OutrightWagerByAccount" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.18" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/OutrightWagerDetails" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.18" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/EventWagerByAccount" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.20" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/EventWagerDetails" ischeckbelonging="true" isallowtodobythemselves="true"/>
      <add id="1.04.21" permission="[L]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/TotalBetParlay" ischeckbelonging="true" isallowtodobythemselves="true"/>      
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>