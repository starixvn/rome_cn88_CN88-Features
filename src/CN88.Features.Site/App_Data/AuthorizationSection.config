<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[B],[D],[E],[H]"
  custIdQueryStringParamNameMapping="custid,CustomerId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer,setting"
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [B]: Account Management Edit & View
    [D]: Total Bets
    [E]: Reports
    [H]: Account Management View Only
  -->
  <GroupPageAccess roleid="0" name="Headline">
    <PageAccesses>
      <add id="0.01.01" permission="[E]" mainfuncname="Reports" subfuncname="Wager" url="Reports/Wager" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="0.01.02" permission="[E]" mainfuncname="Reports" subfuncname="Legacy" url="Reports/Legacy" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="0.01.03" permission="[E]" mainfuncname="Reports" subfuncname="PTHistory" url="Reports/PTHistory" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="0.01.04" permission="[E]" mainfuncname="OldReports" subfuncname="Wager" url="OldReports/Wager" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="0.01.05" permission="[E]" mainfuncname="OldReports" subfuncname="Legacy" url="OldReports/Legacy" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[E]" mainfuncname="Reports" subfuncname="Wager" url="Reports/Wager" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[E]" mainfuncname="Reports" subfuncname="Legacy" url="Reports/Legacy" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[E]" mainfuncname="Reports" subfuncname="PTHistory" url="Reports/PTHistory" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.04" permission="[E]" mainfuncname="OldReports" subfuncname="Wager" url="OldReports/Wager" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.05" permission="[E]" mainfuncname="OldReports" subfuncname="Legacy" url="OldReports/Legacy" ischeckbelonging="true" isallowtodobythemselves="true" />

      <add id="1.02.01" permission="[H],[B]" mainfuncname="Account Management" subfuncname="Downline List" url="CustomerList/GetCustomerList" ischeckbelonging="true" />
      <add id="1.02.02" permission="[H],[B]" mainfuncname="Account Management" subfuncname="Member Statement" url="CustomerList/MemberStatement" ischeckbelonging="true" />
      <add id="1.02.03" permission="[H],[B]" mainfuncname="Account Management" subfuncname="Credit" url="CustomerList/CreditPopup" ischeckbelonging="true" />
      <add id="1.02.04" permission="[B]" mainfuncname="Account Management" subfuncname="Credit Update" url="CustomerList/UpdateCredit" ischeckbelonging="true" />
      <add id="1.02.05" permission="[H],[B]" mainfuncname="Account Management" subfuncname="Customer Status" url="CustomerList/StatusPopup" ischeckbelonging="true" />
      <add id="1.02.06" permission="[B]" mainfuncname="Account Management" subfuncname="Customer Status Update" url="CustomerList/UpdateCustomerStatus" ischeckbelonging="true" />
      <add id="1.02.07" permission="[H],[B]" mainfuncname="Account Management" subfuncname="Customer Setting" url="CN88CustomerSetting/ViewCN88CustomerSetting/Edit" ischeckbelonging="true" />
      <add id="1.02.08" permission="[B]" mainfuncname="Account Management" subfuncname="Customer Setting Update" url="CN88CustomerSetting/UpdateCN88CustomerSetting/Update" ischeckbelonging="true" />
      <add id="1.02.09" permission="[H],[B]" mainfuncname="Account Management" subfuncname="Customer Setting View New" url="CN88CustomerSetting/ViewCN88CustomerSetting/Create" ischeckbelonging="true" />
      <add id="1.02.10" permission="[B]" mainfuncname="Account Management" subfuncname="Customer Setting Create" url="CN88CustomerSetting/CreateCN88Customer/Create" ischeckbelonging="true" />

      <add id="1.03.01" permission="[E]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/BetListOfReport" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.02" permission="[H],[B]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/BetListOfStatement" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.03" permission="[B],[D],[E],[H]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/ParlaySubTickets" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.04" permission="[B],[D],[E],[H]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/ParlayDetail" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.05" permission="[B],[D],[E],[H]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/ParlayDetailExcel" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.06" permission="[E]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/BetListOfReportExcel" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.07" permission="[D]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/OutrightWagerByAccount" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.08" permission="[D]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/OutrightWagerDetails" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.09" permission="[D]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/EventWagerByAccount" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.10" permission="[D]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/EventWagerDetails" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.11" permission="[D]" mainfuncname="Betlist" subfuncname="Betlist" url="BetLists/TotalBetParlay" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>