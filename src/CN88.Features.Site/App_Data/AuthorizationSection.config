<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid,CustId,custId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!-- [E]: Reports -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[H]" mainfuncname="CustomerList" subfuncname="Customer List" url="CustomerList/GetCustomerList" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[B]" mainfuncname="UpdateCustAccount" subfuncname="DCS" url="CN88CustomerSetting/ViewCN88CustomerSetting/Edit" ischeckbelonging="true" />
      <add id="1.01.03" permission="[A]" mainfuncname="UpdateCustAccount" subfuncname="DCS" url="CN88CustomerSetting/ViewCN88CustomerSetting/Create" ischeckbelonging="true" />
      <add id="1.01.04" permission="[B]" mainfuncname="Customer List" subfuncname="Update Credit" url="CustomerList/UpdateCredit" ischeckbelonging="true" />
      <add id="1.01.05" permission="[B]" mainfuncname="Customer List" subfuncname="Update Status" url="CustomerList/UpdateCustomerStatus" ischeckbelonging="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>