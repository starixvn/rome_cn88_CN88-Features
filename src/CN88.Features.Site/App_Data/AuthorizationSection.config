<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid,CustId,custId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!-- [E]: Reports -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[E]" mainfuncname="Report" subfuncname="Main Report" url="Reports/Index" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>