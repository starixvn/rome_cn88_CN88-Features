<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <!--<add id="1.01.01" permission="[E]" mainfuncname="Report" subfuncname="Main Report" url="Reports/Index" ischeckbelonging="true" isallowtodobythemselves="true" />-->
      <add id="1.01.01" permission="[H]" mainfuncname="Account Management" subfuncname="Downline List" url="CustomerList/GetCustomerList" ischeckbelonging="true" />
      <add id="1.01.02" permission="[H]" mainfuncname="Account Management" subfuncname="Statement" url="CustomerList/MemberStatement" ischeckbelonging="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>