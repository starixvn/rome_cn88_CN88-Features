@model MemberStatementViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = CustomerListResources.MemberStatement;
}

@section Styles {
    @StaticResources.RenderStyles("~/CustomerList/bundles/styles/member-statement")
}
<div class="member-statement">
    <div class="page-title">@Model.CustName</div>
    <form class="form-inline filter" role="form" id="report-form">
        @Html.Hidden("CustName", Model.CustName)
        @Html.Hidden("CustId", Model.CustId)
        @SportGroupSelection.Render(Model.SportTypeSelectionViewModel, true)
        @DateTimeSelection.Render(Model.FromDateSelectionViewModel, "fromdate", @BetListsResources.Date)
        @DateTimeSelection.Render(Model.ToDateSelectionViewModel, "todate", @SharedResources.To)
        <div class="form-group">
            <input type="submit" value="@SharedResources.Submit" class="btn-submit" />
        </div>
    </form>
    <table class="tbl-style2">
        <thead>
            <tr>
                <th>@BetListsResources.Date</th>
                <th class="text-right">@BetListsResources.Stake</th>
                <th class="text-right">@ReportResources.ValidStake</th>
                <th class="text-right">@BetListsResources.WinLoss</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Statements.Any())
            {
                <tr>
                    <td class="text-center" colspan="4">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
            @foreach (var item in Model.Statements)
            {
                <tr>
                    <td>
                        @if (item.HasTicket)
                        {
                            <a href="@Model.BetListOfStatementUrl(item.WinLostDate)">@item.WinLostDateStr</a>
                        }
                        else
                        {
                            @item.WinLostDateStr
                        }
                    </td>
                    <td class="text-right">@item.StakeStr</td>
                    <td class="text-right">@item.ValidStakeStr</td>
                    <td class="text-right">@Html.Raw(item.WinLossStr)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            @if (Model.Statements.Any())
            {
                <tr>
                    <td>@ReportResources.Total</td>
                    <td class="text-right">@Model.TotalStakeStr</td>
                    <td class="text-right">@Model.TotalValidStakeStr</td>
                    <td class="text-right">@Html.Raw(Model.TotalWinLossStr)</td>
                </tr>
            }
        </tfoot>
    </table>
</div>
@Html.Hidden("Warning", SharedResources.Warning)
@Html.Hidden("OK", SharedResources.OK)
@Html.Hidden("InvalidDateRange", CustomerListResources.InvalidDateRange)
@section Scripts {
    @StaticResources.RenderScripts("~/CustomerList/bundles/scripts/memberstatement")
}