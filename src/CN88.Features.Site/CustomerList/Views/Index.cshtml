@model IndexViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = CN88.Features.CustomerList.Resources.CustomerListResources.DownlineList;

}
@section Styles {
    @StaticResources.RenderStyles("~/CustomerList/bundles/styles/downline-list")
}
<!----------------- Mobile Tab view ---------------->
<ul id="nav-tabs" class="nav @(Model.IsDevice ? "nav-tabs" : "nav-tabs-style2")" role="tablist">
    @if (Model.ActorLevel.IsSuperLevel())
    {
        @RenderMobileTab(UserLevel.Master, CustomerListResources.Master)
    }
    @if (Model.ActorLevel.IsMasterOrSuperLevel())
    {
        @RenderMobileTab(UserLevel.Agent, CustomerListResources.Agent)
    }
    @RenderMobileTab(UserLevel.Member, CustomerListResources.Member)
</ul>
<!----------------- Desktop Tab view ---------------->
<div class="tab-content">
    @if (Model.ActorLevel.IsSuperLevel())
    {
        @RenderContent(UserLevel.Master, CustomerListResources.NewMasterAgent)
    }
    @if (Model.ActorLevel.IsMasterOrSuperLevel())
    {
        @RenderContent(UserLevel.Agent, CustomerListResources.NewAgent, Model.ActorLevel.IsSuperLevel(), true, CustomerListResources.MasterIsRequired)
    }
    @RenderContent(UserLevel.Member, CustomerListResources.NewMember, Model.ActorLevel.IsMasterOrSuperLevel(), true, CustomerListResources.AgentIsRequired)
</div>
<div class="shadow" id="shadow"></div>
<div class="output" id="output"></div>
@Html.Hidden("directDownline", Model.ActorLevel.GetDirectDownLineLevel().Value)
@Html.Hidden("getCustomerListUrl", Url.Action("GetCustomerList", "CustomerList"))
@Html.Hidden("viewStatementtUrl", Url.Action("MemberStatement", "CustomerList"))
@Html.Hidden("NoInformationIsAvailable", CustomerListResources.NoInformationIsAvailable)
@Html.Hidden("Open", CustomerListResources.Open)
@Html.Hidden("Closed", CustomerListResources.Closed)
@Html.Hidden("Suspended", CustomerListResources.Suspended)
@Html.Hidden("Active", CustomerListResources.Active)
@Html.Hidden("ViewOnly", CustomerListResources.ViewOnly)
@Html.Hidden("Inactive", CustomerListResources.Inactive)
@Html.Hidden("Page", CustomerListResources.Page)
@Html.Hidden("of", CustomerListResources.of)
@Html.Hidden("Pager_DisplayItems", CustomerListResources.Pager_DisplayItems)
@Html.Hidden("usernameAutoSuggestionPath", Model.UsernameAutoSuggestionPath)
@Html.Hidden("EditCustomerLink", Model.EditCustomerLink)
@Html.Hidden("CreateCustomerLink", Model.CreateCustomerLink)
@Html.Hidden("UpdateCreditLink", Model.UpdateCreditLink)
@Html.Hidden("UpdateStatusLink", Model.UpdateStatusLink)
@Html.Hidden("CurrentLink", Model.CurrentLink)
@Html.Hidden(nameof(Model.ResetPasswordLink), Model.ResetPasswordLink)
@Html.Hidden(nameof(Model.ResetSecurityCodeLink), Model.ResetSecurityCodeLink)
@Html.Hidden("AccessDenyPage", Model.AccessDenyPage)
@Html.Hidden("CanDoAddOrUpdateAction", Model.CanDoAddOrUpdateAction ? 1 : 0)
@Html.Hidden("IsShowEditSettingLink", Model.IsShowEditSettingLink ? 1 : 0)
@Html.Hidden("UpdateStatus", CustomerListResources.UpdateStatus)
@Html.Hidden("UpdateCredit", CustomerListResources.UpdateCredit)
@Html.Hidden("ResetPassword", CustomerListResources.ResetPassword)
@Html.Hidden("UnlockTooltip", CustomerListResources.UnlockTooltip)
@Html.Hidden("UnlockConfirmTitle", CustomerListResources.UnlockConfirmTitle)
@Html.Hidden("UnlockConfirmMessage", CustomerListResources.UnlockConfirmMessage)
@Html.Hidden(nameof(SharedResources.OK), SharedResources.OK)
@Html.Hidden(nameof(SharedResources.Cancel), SharedResources.Cancel)
@Html.Hidden("NewMember", CustomerListResources.NewMember)
@Html.Hidden("NewAgent", CustomerListResources.NewAgent)
@Html.Hidden("EditMember", CustomerListResources.EditMember)
@Html.Hidden("EditAgent", CustomerListResources.EditAgent)
@Html.Hidden("EditMasterAgent", CustomerListResources.EditMasterAgent)
@Html.Hidden("ResetSecurityCode", CustomerListResources.ResetSecurityCode)
@Html.Hidden("Disabled", CustomerListResources.Disabled)
@Html.Hidden("AccountManagementEditView", Model.AccountManagementEditView ? 1 : 0)
@Html.Hidden("Language", Model.Language)
@Html.Hidden("ViewerId", Model.ViewerId)
@Html.Hidden("ActorLevel", Model.ActorLevel.Value)
@Html.Hidden("DownlineUsername", Model.DownlineUsername)
@Html.Hidden("Username", Model.Username)
@Html.Hidden("SearchRoleId", Model.SearchRoleId)
@Html.Hidden("Status", Model.Status)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("PageIndex", Model.PageIndex)
@Html.Hidden("IsDevice", Model.IsDevice ? 1 : 0)
@Html.Hidden(nameof(Model.UnlockCustomerPath), Model.UnlockCustomerPath)
@Html.Hidden(nameof(Model.VerifySecurityCodeLink), Model.VerifySecurityCodeLink)
@Html.AntiForgeryToken()
@section Scripts {
    @StaticResources.RenderScripts("~/CustomerList/bundles/scripts/DownlineList/index")
}
@helper RenderContent(
    UserLevel level,
    string submitButtonLabel,
    bool renderUplineSearchingText = false,
    bool renderRequiredHint = false,
    string requiredHint = "")
{
    <div id="@($"tab{level.DisplayName}")" class="tab-pane fade @(IsActiveTab(level) ? "in active" : string.Empty)" role="tabpanel">
        @RenderFilter(level, submitButtonLabel, renderUplineSearchingText, renderRequiredHint, requiredHint)
        @RenderContainer(level)
    </div>
}
@helper RenderFilter(
    UserLevel level,
    string submitButtonLabel,
    bool renderUplineSearchingText = false,
    bool renderRequiredHint = false,
    string requiredHint = "")
{
    var levelName = level.DisplayName.ToLower();
    var uplineLevelName = level.GetDirectUpLineLevel().DisplayName.ToLower();

    if (Model.IsDevice)
    {
        <div class="filter-mobile">
            <span class="icon-filter-down" id="@($"{levelName}-filter-toggle-icon")"></span>
            @if (Model.CanDoAddOrUpdateAction)
            {
                @RenderAddNewButton(levelName, submitButtonLabel)
            }
        </div>
    }

    <div class="filter">
        <div id="@($"form-{levelName}")" class="form-inline" role="form">
            @if (renderUplineSearchingText)
            {
                <div class="form-group">
                    <label>@(level.IsAgentLevel() ? CustomerListResources.Master : CustomerListResources.Agent)</label>
                    <input id="@($"txt-viewed-{level.GetDirectUpLineLevel().DisplayName.ToLower()}")" class="control txt-username-nickname" type="text" value="" />
                </div>
            }
            <div class="form-group">
                <label>@CustomerListResources.UsernameOrNameContains</label>
                <input id="@($"txt-username-{levelName}")" class="control txt-username-nickname" type="text" value="" />
            </div>
            <div class="form-group">
                <label>@CustomerListResources.Status</label>
                <select id="@($"dropdown-status-{levelName}")" class="control">
                    @foreach (var option in CustomerStatus.Statuses)
                    {
                        <option value="@option.Value" @(Model.Status == option.Key ? "selected='selected'" : "")>@CustomerListResources.ResourceManager.GetString(option.Value)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <input id="@($"btn-submit-{levelName}")" class="btn-submit" type="button" value="@CustomerListResources.Submit" />
            </div>
            @if (renderRequiredHint)
            {
                <div id="@($"msg-err-{levelName}")" class="msg msg-error display-none">@requiredHint</div>
            }
            @if (Model.IsNotPhone && Model.CanDoAddOrUpdateAction)
            {
                @RenderAddNewButton(levelName, submitButtonLabel)
            }
        </div>
    </div>
}
@helper RenderContainer(UserLevel level)
{
    var levelName = level.DisplayName.ToLower();
    var columns = new[]
    {
new { Text = CustomerListResources.No, ClassName = "col-no", Show = !Model.IsDevice},
new {
Text = Model.IsDevice ?
$"{CustomerListResources.Username} <br /> {CustomerListResources.Nickname} <br /> {CustomerListResources.Name}" :
CustomerListResources.Username,
ClassName = "col-username",
Show = true
},
new { Text = CustomerListResources.Name, ClassName = "col-name", Show = !Model.IsDevice},
new { Text = CustomerListResources.Nickname, ClassName = "col-nickname", Show = !Model.IsDevice},
new { Text = CustomerListResources.Group, ClassName = string.Empty, Show = level.IsMemberLevel()},
new { Text = CustomerListResources.Credit, ClassName = "text-right", Show = true},
new { Text = CustomerListResources.CreationDate, ClassName = "col-creation-date", Show = !Model.IsDevice},
new { Text = CustomerListResources.Status, ClassName = "text-center", Show = true},
new { Text = CustomerListResources.Action, ClassName = "col-action", Show = true}
}.ToList();

<div id="@($"{levelName}-container")">
    <table id="@($"tbl-{levelName}")" class="tbl-style2 tbl-downlinelist @($"level-{levelName}")">
        <thead>
            <tr>
                @foreach (var column in columns)
                {
                    if (column.Show)
                    {
                        <th class="@column.ClassName">@Html.Raw(column.Text)</th>
                    }
                }
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot></tfoot>
    </table>
    @if (Model.IsNotPhone)
    {
        <div id="@($"pager-{levelName}")"></div>
    }
</div>
}
@helper RenderAddNewButton(string levelName, string submitButtonLabel)
{
    <button id="add-directdownline"
            disabled
            cust-id=""
            username=""
            downline-username=""
            class="btn-submit add-new @($"add-directdownline-{levelName}")">
        <span class="icon-add">
        </span>@submitButtonLabel
    </button>
}
@helper RenderMobileTab(UserLevel level, string displayName)
{
    <li @(IsActiveTab(level) ? "class=active" : string.Empty) role="presentation">
        <a id="@($"tab{level.Value}")" data-toggle="tab" href="@($"#tab{level.DisplayName}")">@displayName</a>
    </li>
}
@functions{
    public bool IsActiveTab(UserLevel userLevel)
    {
        return Model.ActorLevel.GetDirectDownLineLevel().Value == userLevel.Value;
    }
}