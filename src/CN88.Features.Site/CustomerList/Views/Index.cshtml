@model IndexViewModel

@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/CustomerList/bundles/styles/downline-list")
}

<ul id="nav-tabs" class="nav nav-tabs-style2" role="tablist">
    @if (Model.ActorLevel.IsSuperLevel())
    {
        <li class="lnk-changetab" role="presentation" level="@UserLevel.Master.Value">
            <a>@CustomerListResources.Master</a>
        </li>
    }

    @if (Model.ActorLevel.IsMasterOrSuperLevel())
    {
        <li class="lnk-changetab" role="presentation" level="@UserLevel.Agent.Value">
            <a>@CustomerListResources.Agent</a>
        </li>
    }

    <li class="lnk-changetab" role="presentation" level="@UserLevel.Member.Value">
        <a>@CustomerListResources.Member</a>
    </li>
</ul>

@if (Model.ActorLevel.IsSuperLevel())
{
    <div class="tab-content display-none" level="@UserLevel.Master.Value">
        <div class="tab-panel active" role="tabpanel">
            <div class="filter">
                <div id="form-master" class="form-inline" role="form">
                    <div class="form-group">
                        <label>@CustomerListResources.UsernameOrNameContains</label>
                        <input id="txt-username-master" class="control" type="text" value="" />
                    </div>
                    <div class="form-group">
                        <label>@CustomerListResources.Status</label>
                        <select id="dropdown-status-master" class="control">
                            <option value="@CustomerStatus.All">@CustomerListResources.All</option>
                            <option value="@CustomerStatus.Open">@CustomerListResources.Open</option>
                            <option value="@CustomerStatus.Closed">@CustomerListResources.Closed</option>
                            <option value="@CustomerStatus.Suspended">@CustomerListResources.Suspended</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <input id="btn-submit-master" class="btn-submit" type="button" value="@CustomerListResources.Submit" />
                    </div>
                    <button id="add-directdownline" cust-id="" username="" downline-username="" class="btn-submit add-new"><span class="icon-add"></span>@CustomerListResources.NewMasterAgent</button>
                </div>
            </div>

            <table id="tbl-master" class="tbl-style2">
                <thead>
                    <tr>
                        <th class="col-no">@CustomerListResources.No</th>
                        <th class="col-username">@CustomerListResources.Username</th>
                        <th class="col-name">@CustomerListResources.Name</th>
                        <th class="col-nickname">@CustomerListResources.Nickname</th>
                        <th>@CustomerListResources.Credit</th>
                        <th class="col-creation-date">@CustomerListResources.CreationDate</th>
                        <th class="col-status">@CustomerListResources.Status</th>
                        <th class="col-action">@CustomerListResources.Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot></tfoot>
            </table>
        </div>
    </div>
}

@if (Model.ActorLevel.IsMasterOrSuperLevel())
{
    <div class="tab-content display-none" level="@UserLevel.Agent.Value">
        <div class="tab-panel active" role="tabpanel">
            <div class="filter">
                <div id="form-agent" class="form-inline" role="form">
                    @if (Model.ActorLevel.IsSuperLevel() || Model.IsInternal)
                    {
                        <div class="form-group">
                            <label>@CustomerListResources.Master</label>
                            <input id="txt-viewed-master" class="control" type="text" value="" />
                        </div>
                    }

                    <div class="form-group">
                        <label>@CustomerListResources.UsernameOrNameContains</label>
                        <input id="txt-username-agent" class="control" type="text" value="" />
                    </div>
                    <div class="form-group">
                        <label>@CustomerListResources.Status</label>
                        <select id="dropdown-status-agent" class="control">
                            <option value="@CustomerStatus.All">@CustomerListResources.All</option>
                            <option value="@CustomerStatus.Open">@CustomerListResources.Open</option>
                            <option value="@CustomerStatus.Closed">@CustomerListResources.Closed</option>
                            <option value="@CustomerStatus.Suspended">@CustomerListResources.Suspended</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <input id="btn-submit-agent" class="btn-submit" type="button" value="@CustomerListResources.Submit" />
                    </div>
                    <div id="msg-err-agent" class="msg msg-error display-none">@CustomerListResources.MasterIsRequired</div>
                    <button id="add-directdownline" cust-id="" username="" downline-username="" class="btn-submit add-new"><span class="icon-add"></span>@CustomerListResources.NewAgent</button>
                </div>
            </div>
            <table id="tbl-agent" class="tbl-style2">
                <thead>
                    <tr>
                        <th class="col-no">@CustomerListResources.No</th>
                        <th class="col-username">@CustomerListResources.Username</th>
                        <th class="col-name">@CustomerListResources.Name</th>
                        <th class="col-nickname">@CustomerListResources.Nickname</th>
                        <th>@CustomerListResources.Credit</th>
                        <th class="col-creation-date">@CustomerListResources.CreationDate</th>
                        <th class="col-status">@CustomerListResources.Status</th>
                        <th class="col-action">@CustomerListResources.Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot></tfoot>
            </table>
        </div>
    </div>
}

<div class="tab-content display-none" level="@UserLevel.Member.Value">
    <div class="tab-panel active" role="tabpanel">
        <div class="filter">
            <div id="form-member" class="form-inline" role="form">
                @if (Model.ActorLevel.IsMasterOrSuperLevel() || Model.IsInternal)
                {
                    <div class="form-group">
                        <label>@CustomerListResources.Agent</label>
                        <input id="txt-viewed-agent" class="control" type="text" value="" />
                    </div>
                }

                <div class="form-group">
                    <label>@CustomerListResources.UsernameOrNameContains</label>
                    <input id="txt-username-member" class="control" type="text" value="" />
                </div>
                <div class="form-group">
                    <label>@CustomerListResources.Status</label>
                    <select id="dropdown-status-member" class="control">
                        <option value="@CustomerStatus.All">@CustomerListResources.All</option>
                        <option value="@CustomerStatus.Open">@CustomerListResources.Open</option>
                        <option value="@CustomerStatus.Closed">@CustomerListResources.Closed</option>
                        <option value="@CustomerStatus.Suspended">@CustomerListResources.Suspended</option>
                    </select>
                </div>
                <div class="form-group">
                    <input id="btn-submit-member" class="btn-submit" type="button" value="@CustomerListResources.Submit" />
                </div>
                <div id="msg-err-member" class="msg msg-error display-none">@CustomerListResources.AgentIsRequired</div>
                <button id="add-directdownline" cust-id="" username="" downline-username="" class="btn-submit add-new"><span class="icon-add"></span>@CustomerListResources.NewMember</button>
            </div>
        </div>
        <table id="tbl-member" class="tbl-style2">
            <thead>
                <tr>
                    <th class="col-no">@CustomerListResources.No</th>
                    <th class="col-username">@CustomerListResources.Username</th>
                    <th class="col-name">@CustomerListResources.Name</th>
                    <th class="col-nickname">@CustomerListResources.Nickname</th>
                    <th>@CustomerListResources.Group</th>
                    <th>@CustomerListResources.Credit</th>
                    <th class="col-creation-date">@CustomerListResources.CreationDate</th>
                    <th class="col-status">@CustomerListResources.Status</th>
                    <th class="col-action">@CustomerListResources.Action</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot></tfoot>
        </table>
    </div>
</div>

<div class="shadow" id="shadow"></div>
<div class="output" id="output"></div>
@Html.Hidden("directDownline", Model.ActorLevel.GetDirectDownLineLevel().Value)
@Html.Hidden("getCustomerListUrl", Url.Action("GetCustomerList", "CustomerList"))
@Html.Hidden("viewStatementtUrl", Url.Action("MemberStatement", "CustomerList"))

@Html.Hidden("NoInformationIsAvailable", CustomerListResources.NoInformationIsAvailable)
@Html.Hidden("Open", CustomerListResources.Open)
@Html.Hidden("Closed", CustomerListResources.Closed)
@Html.Hidden("Suspended", CustomerListResources.Suspended)
@Html.Hidden("Page", CustomerListResources.Page)
@Html.Hidden("of", CustomerListResources.of)
@Html.Hidden("Pager_DisplayItems", CustomerListResources.Pager_DisplayItems)
@Html.Hidden("usernameAutoSuggestionPath", Model.UsernameAutoSuggestionPath)
@Html.Hidden("EditCustomerLink", Model.EditCustomerLink)
@Html.Hidden("CreateCustomerLink", Model.CreateCustomerLink)
@Html.Hidden("UpdateCreditLink", Model.UpdateCreditLink)
@Html.Hidden("UpdateStatusLink", Model.UpdateStatusLink)
@Html.Hidden("CurrentLink", Model.CurrentLink)
@Html.Hidden(nameof(Model.ResetPasswordLink), Model.ResetPasswordLink)
@Html.Hidden(nameof(Model.ResetSecurityCodeLink), Model.ResetSecurityCodeLink)

@Html.Hidden("UpdateStatus", CustomerListResources.UpdateStatus)
@Html.Hidden("UpdateCredit", CustomerListResources.UpdateCredit)
@Html.Hidden("ResetPassword", CustomerListResources.ResetPassword)

@Html.Hidden("NewMember", CustomerListResources.NewMember)
@Html.Hidden("NewAgent", CustomerListResources.NewAgent)
@Html.Hidden("EditMember", CustomerListResources.EditMember)
@Html.Hidden("EditAgent", CustomerListResources.EditAgent)
@Html.Hidden("EditMasterAgent", CustomerListResources.EditMasterAgent)




@Html.Hidden("ResetSecurityCode", CustomerListResources.ResetSecurityCode)
@Html.Hidden("Disabled", CustomerListResources.Disabled)
@Html.Hidden("HasUpdatePermission", Model.HasUpdatePermission ? 1 : 0)
@Html.Hidden("HasAddNewPermission", Model.HasAddNewPermission ? 1 : 0)
@Html.Hidden("Language", Model.Language)
@Html.Hidden("ViewerId", Model.ViewerId)
@Html.Hidden("ActorLevel", Model.ActorLevel.Value)

@Html.Hidden("DownlineUsername", Model.DownlineUsername)
@Html.Hidden("Username", Model.Username)
@Html.Hidden("SearchRoleId", Model.SearchRoleId)
@Html.Hidden("Status", Model.Status)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("PageIndex", Model.PageIndex)

@section Scripts {
    @StaticResources.RenderScripts("~/CustomerList/bundles/scripts/index")
}
