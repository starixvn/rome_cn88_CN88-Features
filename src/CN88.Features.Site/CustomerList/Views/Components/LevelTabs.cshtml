@model UserLevel

<ul id="nav-tabs" class="nav @(ViewData["CssClass"])" role="tablist">
    @if (Model.IsSuperLevel())
    {
        <li class="lnk-changetab" role="presentation" level="@UserLevel.Master.Value">
            <a>@CustomerListResources.Master</a>
        </li>
    }

    @if (Model.IsMasterOrSuperLevel())
    {
        <li class="lnk-changetab" role="presentation" level="@UserLevel.Agent.Value">
            <a>@CustomerListResources.Agent</a>
        </li>
    }

    <li class="lnk-changetab" role="presentation" level="@UserLevel.Member.Value">
        <a>@CustomerListResources.Member</a>
    </li>
</ul>
