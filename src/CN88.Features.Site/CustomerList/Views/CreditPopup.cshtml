@model CreditRangeViewModel

@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStyles("~/CustomerList/bundles/styles/popup")
}

<div class="popup-modal form">
    <div class="col-xs-12 hidden msg" id="error-message"></div>
    <div class="used-credit">
        <span>@CustomerListResources.UsedCredit</span>
        <span class="bold">@Model.CreditModel.UsedCredit.ToString("N2")</span>
    </div>
    <div class="form-group">
        <label>@CustomerListResources.Credit</label>
        <input class="txt-credit" id="credit" type="text" />
        <div class="credit-range">[@Model.CreditModel.MinCredit.ToString("N2"); @Model.CreditModel.MaxCredit.ToString("N2")]</div>
    </div>
    <div class="list-button">
        <button type="button" class="btn-submit">@CustomerListResources.Save</button>
        <button type="button" class="btn-cancel">@CustomerListResources.Cancel</button>
    </div>  
</div>

@Html.Hidden("MinCredit", Model.CreditModel.MinCredit)
@Html.Hidden("MaxCredit", Model.CreditModel.MaxCredit)
@Html.Hidden("CustId", Model.CustId)
@Html.Hidden("CustLevelId", Model.CustLevel.Value)
@Html.Hidden("UpdateSuccessfully", CustomerListResources.UpdateSuccessfully)
@Html.Hidden("ExceededAgentCredit", CustomerListResources.ExceededAgentCredit)
@Html.Hidden("InputNumberError", CustomerListResources.InputNumberError)
@Html.AntiForgeryToken()

@section Scripts {
    @StaticResources.RenderScripts("~/CustomerList/bundles/scripts/popup/credit-popup")
}
