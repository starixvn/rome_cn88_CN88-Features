@model StatusPopupViewModel

@{
	Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
	@StaticResources.RenderStyles("~/CustomerList/bundles/styles/popup")
}

<div class="popup-modal form">
	<div class="col-xs-12 hidden msg" id="error-message"></div>
    <div class="form-group">
        <label>@CustomerListResources.Status</label>
        <select id="dropdown-status" class="control">
            <option value="@CustomerStatus.Active" @(Model.UpdateStatusId.Equals(CustomerStatus.Active) ? "selected" : string.Empty)>
                @CustomerListResources.Active
            </option>
            @if (Model.UpdateStatusId.Equals(CustomerStatus.Active) || Model.UpdateStatusId.Equals(CustomerStatus.ViewOnly))
            {
                <option value="@CustomerStatus.ViewOnly" @(Model.UpdateStatusId.Equals(CustomerStatus.ViewOnly) ? "selected" : string.Empty)>
                    @CustomerListResources.ViewOnly
                </option>
            }
            @if (Model.UpdateStatusId.Equals(CustomerStatus.Active) || Model.UpdateStatusId.Equals(CustomerStatus.Suspended))
            {
                <option value="@CustomerStatus.Suspended" @(Model.UpdateStatusId.Equals(CustomerStatus.Suspended) ? "selected" : string.Empty)>
                    @CustomerListResources.Suspended
                </option>
            }
            @if (Model.UpdateStatusId.Equals(CustomerStatus.Active) || Model.UpdateStatusId.Equals(CustomerStatus.Inactive))
            {
                <option value="@CustomerStatus.Inactive" @(Model.UpdateStatusId.Equals(CustomerStatus.Inactive) ? "selected" : string.Empty)>
                    @CustomerListResources.Inactive
                </option>
            }
        </select>
    </div>
    <div class="list-button">
        <button type="button" class="btn-submit">@CustomerListResources.Save</button>
        <button type="button" class="btn-cancel">@CustomerListResources.Cancel</button>
    </div>
</div>

@Html.Hidden("CustId", Model.CustId)
@Html.Hidden("UpdateSuccessfully", CustomerListResources.UpdateSuccessfully)
@Html.Hidden("CurrentStatusId", Model.UpdateStatusId)
@Html.Hidden("ThereIsNoChange", CustomerListResources.ThereIsNoChange)
@Html.AntiForgeryToken()

@section Scripts {
	@StaticResources.RenderScripts("~/CustomerList/bundles/scripts/popup/status-popup")
}