@model StatusPopupViewModel

@{
	Layout = "~/Shared/Views/_Layout.cshtml";
}

@section Styles {
	@StaticResources.RenderStyles("~/assets/bundles/popup")
}

<div class="popup-modal">
	<div class="col-xs-12 hidden msg" id="error-message"></div>
	<div class="form-group col-xs-12">
		<div class="col-xs-4 status-label">
			@CustomerListResources.Status
		</div>
		<div class="col-xs-7">
			<select id="dropdown-status" class="dropdown-status">
				<option value="@CustomerStatus.Open" @(Model.UpdateStatusId.Equals(CustomerStatus.Open) ? "selected" : string.Empty)>
					@CustomerListResources.Open
				</option>
				<option value="@CustomerStatus.Suspended" @(Model.UpdateStatusId.Equals(CustomerStatus.Suspended) ? "selected" : string.Empty)>
					@CustomerListResources.Suspended
				</option>
				<option value="@CustomerStatus.Closed" @(Model.UpdateStatusId.Equals(CustomerStatus.Closed) ? "selected" : string.Empty)>
					@CustomerListResources.Closed
				</option>
			</select>
		</div>
	</div>
	<div class="col-xs-8 row-info popup-bottom list-button">
		<button type="button" class="btn-submit">@CustomerListResources.Save</button>
		<button type="button" class="btn-cancel">@CustomerListResources.Cancel</button>
	</div>
</div>

@Html.Hidden("CustId", Model.CustId)
@Html.Hidden("UpdateSuccessfully", CustomerListResources.UpdateSuccessfully)
@Html.Hidden("CurrentStatusId", Model.UpdateStatusId)
@Html.Hidden("ThereIsNoChange", CustomerListResources.ThereIsNoChange)
@Html.AntiForgeryToken()

@section Scripts {
	@StaticResources.RenderScripts("~/CustomerList/bundles/scripts/popup/status-popup")
}
