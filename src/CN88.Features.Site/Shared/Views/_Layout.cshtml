@using System.Configuration
@{ 
    
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes">
    <meta name="format-detection" content="telephone=no">
    <title>@ViewBag.Title</title>
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-features/default")
    @RenderSection("Styles", required: false)
</head>
<body @Html.Raw(CN88.Web.Helpers.BrowserManager.BuildMobileHtmlClass())>
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-features/default")
    @RenderSection("Scripts", required: false)
    @*@Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())*@
    @CN88.Web.Helpers.GoogleAnalyticHepler.Render()
</body>
</html>