@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    int divisor = Model.Divisor;
}
<table class="tbl-noborder tbl-report" id="tbl-report">
    <thead>
        <tr>
            <th class="text-left">@ReportResources.AgentUsername</th>
            <th class="text-left">@ReportResources.Name</th>
            <th class="text-right">@ReportResources.Wagers</th>
            <th class="text-right">@ReportResources.Stake</th>
            <th class="text-right">@ReportResources.ValidStake</th>
            <th class="text-right">@ReportResources.MemberIncome</th>
            <th class="text-right">@ReportResources.Agent</th>
            <th class="text-right">@ReportResources.AgentPoss</th>
            <th class="text-right">@ReportResources.AgentIncome</th>
            <th class="text-right">@ReportResources.AgentResult</th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right">@ReportResources.MAPoss</th>
                <th class="text-right">@ReportResources.MAIncome</th>
                <th class="text-right">@ReportResources.MAResult</th>
            }
            <th class="text-right">@ReportResources.AgentStock</th>
            @*<th></th>*@
        </tr>
        @if (Model.ReportData.Any())
        {
            <tr class="total">
                <th class="text-left">@ReportResources.Total</th>
                <th></th>
                @HtmlHelpers.RenderHeaderNumberCell(total.Wagers)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent)
                <th></th>
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult)
                @if (Model.IsNotOwner)
                {
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterResult)
                }
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentStock)
                @*<th></th>*@
            </tr>
        }
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {

            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    <td class="text-left">@row.Name</td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Stake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Agent)
                    <td class="text-right">@row.AgentPoss</td>
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentResult)
                    @if (Model.IsNotOwner)
                    {
                        <td class="text-right">@row.MasterPoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, row.MasterIncome)
                        @HtmlHelpers.RenderNumberCell(divisor, row.MasterResult)
                    }
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentStock)
                    @*<td><span class="icon-history" data-custid="@row.CustId" data-toggle="tooltip" data-placement="top" title="History Possess" ></span></td>*@
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(Model.IsNotOwner ? "15" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>
@Html.Hidden("PTHistoryUrl", Url.Action("PTHistory", "Reports"))