@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<table class="tbl-noborder tbl-report" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username">@ReportResources.AgentUsername</th>
            <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Name">@ReportResources.Name</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Wagers">@ReportResources.Wagers</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Stake">@ReportResources.Stake</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="ValidStake">@ReportResources.ValidStake</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MemberIncome">@ReportResources.MemberIncome</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Agent">@ReportResources.Agent</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentPoss">
                @ReportResources.AgentPoss <span class="icon-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess"></span>
            </th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentIncome">@ReportResources.AgentIncome</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResult">@ReportResources.AgentResult</th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MAPoss">@ReportResources.MAPoss</th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MAIncome">@ReportResources.MAIncome</th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MAResult">@ReportResources.MAResult</th>
            }
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentStock">@ReportResources.AgentStock</th>
            @*<th></th>*@
        </tr>
        @if (Model.ReportData.Any())
        {
            <tr class="total">
                <th class="text-left">@ReportResources.Total</th>
                <th></th>
                @HtmlHelpers.RenderHeaderNumberCell(total.Wagers)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent)
                <th></th>
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult)
                @if (Model.IsNotOwner)
                {
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterResult)
                }
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentStock)
                @*<th></th>*@
            </tr>
        }
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {

            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a class="downline-link" href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    <td class="text-left">@row.Name</td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Stake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Agent)
                    <td class="text-right">@row.AgentPoss</td>
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentResult)
                    @if (Model.IsNotOwner)
                    {
                        <td class="text-right">@row.MasterPoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, row.MasterIncome)
                        @HtmlHelpers.RenderNumberCell(divisor, row.MasterResult)
                    }
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentStock)
                    @*<td><span class="icon-history" data-custid="@row.CustId" data-toggle="tooltip" data-placement="top" title="History Possess" ></span></td>*@
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(Model.IsNotOwner ? "15" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>
@Html.Hidden("PTHistoryUrl", Url.Action("PTHistory", "Reports"))