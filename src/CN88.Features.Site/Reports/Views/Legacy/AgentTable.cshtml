@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<table class="tbl-noborder tbl-report" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username"><span class="sorting-item">@ReportResources.AgentUsername</span></th>
            <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Name"><span class="sorting-item">@ReportResources.Name</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Wagers"><span class="sorting-item">@ReportResources.Wagers</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Stake"><span class="sorting-item">@ReportResources.Stake</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="ValidStake"><span class="sorting-item">@ReportResources.ValidStake</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MemberIncome"><span class="sorting-item">@ReportResources.MemberIncome</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Agent"><span class="sorting-item">@ReportResources.Agent</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentPoss">
                <span class="sorting-item more-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess">@ReportResources.AgentPoss</span>
            </th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentIncome"><span class="sorting-item">@ReportResources.AgentIncome</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResult"><span class="sorting-item">@ReportResources.AgentResult</span></th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MAPoss">
                    <span class="sorting-item more-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess">@ReportResources.MAPoss</span>
                </th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MAIncome"><span class="sorting-item">@ReportResources.MAIncome</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MAResult"><span class="sorting-item">@ReportResources.MAResult</span></th>
            }
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentStock"><span class="sorting-item">@ReportResources.AgentStock</span></th>
            @*<th></th>*@
        </tr>
        @if (Model.ReportData.Any())
        {
            <tr class="total">
                <th class="text-left">@ReportResources.Total</th>
                <th></th>
                @HtmlHelpers.RenderHeaderNumberCell(total.Wagers, string.Empty)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent)
                <th></th>
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult)
                @if (Model.IsNotOwner)
                {
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterResult)
                }
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentStock)
                @*<th></th>*@
            </tr>
        }
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {

            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a class="downline-link" href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    <td class="text-left">@row.Name</td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Stake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Agent)
                    <td class="text-right">@row.AgentPoss</td>
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentResult)
                    @if (Model.IsNotOwner)
                    {
                        <td class="text-right">@row.MasterPoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, row.MasterIncome)
                        @HtmlHelpers.RenderNumberCell(divisor, row.MasterResult)
                    }
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentStock)
                    @*<td><span class="icon-history" data-custid="@row.CustId" data-toggle="tooltip" data-placement="top" title="History Possess" ></span></td>*@
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(Model.IsNotOwner ? "15" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>
@Html.Hidden("PTHistoryUrl", Url.Action("PTHistory", "Reports"))