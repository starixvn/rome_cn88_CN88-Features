@using CN88.Features.Extensions
@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<table class="tbl-noborder tbl-report" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username"><span class="sorting-item">@ReportResources.SMAUsername</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Wagers"><span class="sorting-item">@ReportResources.Wagers</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Stake"><span class="sorting-item">@ReportResources.Stake</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="ValidStake"><span class="sorting-item">@ReportResources.ValidStake</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MemberIncome"><span class="sorting-item">@ReportResources.MemberIncome</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Agent"><span class="sorting-item">@ReportResources.Agent</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResult"><span class="sorting-item">@ReportResources.AgentResult</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MasterAgent"><span class="sorting-item">@ReportResources.MasterAgent</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMA"><span class="sorting-item">@ReportResources.SMA</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAIncome"><span class="sorting-item">@ReportResources.SMAIncome</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAResult"><span class="sorting-item">@ReportResources.SMAResult</span></th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAStock"><span class="sorting-item">@ReportResources.SMAStock</span></th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAStockPercent"><span class="sorting-item">@ReportResources.SMAStockPercent</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlinePoss">
                    <span class="sorting-item more-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess">@ReportResources.HeadlinePoss</span>
                </th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineIncome"><span class="sorting-item">@ReportResources.HeadlineIncome</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineResult"><span class="sorting-item">@ReportResources.HeadlineResult</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineStock"><span class="sorting-item">@ReportResources.HeadlineStock</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineStockPercent"><span class="sorting-item">@ReportResources.HeadlineStockPercent</span></th>
            }
        </tr>
        @if (Model.ReportData.Any())
        {
            <tr class="total">
                <th class="text-left">@ReportResources.Total</th>
                @HtmlHelpers.RenderHeaderNumberCell(total.Wagers)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Master)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Super)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperResult)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperStock)
                @if (Model.IsNotOwner)
                {
                    @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineResult)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineStock)
                    @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                }
            </tr>
        }
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a class="downline-link" href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Stake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Agent)
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentResult)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Master)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Super)
                    @HtmlHelpers.RenderNumberCell(divisor, row.SuperIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.SuperResult)
                    @HtmlHelpers.RenderNumberCell(divisor, row.SuperStock)
                    @if (Model.IsNotOwner)
                    {
                        @ReportHtmlHelpers.RenderStockPercentCell(row.SuperStock, total.SuperStock)
                        <td class="text-right">@row.HeadlinePoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, row.HeadlineIncome)
                        @HtmlHelpers.RenderNumberCell(divisor, row.HeadlineResult)
                        @HtmlHelpers.RenderNumberCell(divisor, row.HeadlineStock)
                        @ReportHtmlHelpers.RenderStockPercentCell(row.HeadlineStock, total.HeadlineStock)
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td class="profit-margin" colspan="@(Model.IsNotOwner ? "18" : "12")" align="right">
                    <strong>@ReportResources.ProfitMagin <span class="@(Model.ProfitMargin < 0 ? "negative-value" : string.Empty)">@HtmlHelpers.FormatNumber(Model.ProfitMargin) %</span></strong>
                </td>
            </tr>
        </tfoot>
    }
    else
    {
        <tbody>
            <tr>
                <td colspan="@(Model.IsNotOwner ? "18" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
</table>