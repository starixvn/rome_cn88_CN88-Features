@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
}
<table class="tbl-noborder tbl-report" id="tbl-report">
    <thead>
        <tr>
            <th class="text-left">@ReportResources.SMAUsername</th>
            <th class="text-right">@ReportResources.Wagers</th>
            <th class="text-right">@ReportResources.Stake</th>
            <th class="text-right">@ReportResources.ValidStake</th>
            <th class="text-right">@ReportResources.MemberIncome</th>
            <th class="text-right">@ReportResources.Agent</th>
            <th class="text-right">@ReportResources.AgentResult</th>
            <th class="text-right">@ReportResources.MasterAgent</th>
            <th class="text-right">@ReportResources.SMA</th>
            <th class="text-right">@ReportResources.SMAIncome</th>
            <th class="text-right">@ReportResources.SMAResult</th>
            <th class="text-right">@ReportResources.SMAStock</th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right">@ReportResources.SMAStockPercent</th>
                <th class="text-right">@ReportResources.HeadlinePoss</th>
                <th class="text-right">@ReportResources.HeadlineIncome</th>
                <th class="text-right">@ReportResources.HeadlineResult</th>
                <th class="text-right">@ReportResources.HeadlineStock</th>
                <th class="text-right">@ReportResources.HeadlineStockPercent</th>
            }
        </tr>
        @if (Model.ReportData.Any())
        {
            <tr class="total">
                <td class="text-left">@ReportResources.Total</td>
                @HtmlHelpers.RenderNumberCell(total.Wagers)
                @HtmlHelpers.RenderNumberCell(total.Stake)
                @HtmlHelpers.RenderNumberCell(total.ValidStake)
                @HtmlHelpers.RenderNumberCell(total.MemberIncome)
                @HtmlHelpers.RenderNumberCell(total.Agent)
                @HtmlHelpers.RenderNumberCell(total.AgentResult)
                @HtmlHelpers.RenderNumberCell(total.Master)
                @HtmlHelpers.RenderNumberCell(total.Super)
                @HtmlHelpers.RenderNumberCell(total.SuperIncome)
                @HtmlHelpers.RenderNumberCell(total.SuperResult)
                @HtmlHelpers.RenderNumberCell(total.SuperStock)
                @if (Model.IsNotOwner)
                {
                    @ReportHtmlHelpers.RenderPercentCell(100)
                    <td></td>
                    @HtmlHelpers.RenderNumberCell(total.HeadlineIncome)
                    @HtmlHelpers.RenderNumberCell(total.HeadlineResult)
                    @HtmlHelpers.RenderNumberCell(total.HeadlineStock)
                    @ReportHtmlHelpers.RenderPercentCell(100)
                }
            </tr>
        }
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(row.Stake)
                    @HtmlHelpers.RenderNumberCell(row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(row.Agent)
                    @HtmlHelpers.RenderNumberCell(row.AgentResult)
                    @HtmlHelpers.RenderNumberCell(row.Master)
                    @HtmlHelpers.RenderNumberCell(row.Super)
                    @HtmlHelpers.RenderNumberCell(row.SuperIncome)
                    @HtmlHelpers.RenderNumberCell(row.SuperResult)
                    @HtmlHelpers.RenderNumberCell(row.SuperStock)
                    @if (Model.IsNotOwner)
                    {
                        @ReportHtmlHelpers.RenderStockPercentCell(row.SuperStock, total.SuperStock)
                        <td class="text-right">@row.HeadlinePoss</td>
                        @HtmlHelpers.RenderNumberCell(row.HeadlineIncome)
                        @HtmlHelpers.RenderNumberCell(row.HeadlineResult)
                        @HtmlHelpers.RenderNumberCell(row.HeadlineStock)
                        @ReportHtmlHelpers.RenderStockPercentCell(row.HeadlineStock, total.HeadlineStock)
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td class="profit-margin" colspan="@(Model.IsNotOwner ? "18" : "12")" align="right"><strong>@ReportResources.ProfitMagin</strong> <strong>@HtmlHelpers.FormatNumber(Model.ProfitMargin) %</strong></td>
            </tr>
        </tfoot>
    }
    else
    {
        <tbody>
            <tr>
                <td colspan="@(Model.IsNotOwner ? "18" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
</table>