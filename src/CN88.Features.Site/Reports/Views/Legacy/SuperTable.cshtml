@model ReportViewModel
<table class="tbl-noborder tbl-report" id="tbl-report">
    <thead>
        <tr>
            <th class="text-left">@ReportResources.SMAUsername<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@SharedResources.Wagers<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@SharedResources.Stake<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@ReportResources.ValidStake<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@ReportResources.MemberIncome<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@SharedResources.Agent<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@ReportResources.AgentResult<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@ReportResources.MasterAgent<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@SharedResources.SMA<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@ReportResources.SMAIncome<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@ReportResources.SMAResult<span class="icon-sort-arrow"></span></th>
            <th class="text-right">@ReportResources.SMAStock<span class="icon-sort-arrow"></span></th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right">@ReportResources.SMAStockPercent<span class="icon-sort-arrow"></span></th>
                <th class="text-right">@ReportResources.HeadlinePoss<span class="icon-sort-arrow"></span></th>
                <th class="text-right">@ReportResources.HeadlineIncome<span class="icon-sort-arrow"></span></th>
                <th class="text-right">@ReportResources.HeadlineResult<span class="icon-sort-arrow"></span></th>
                <th class="text-right">@ReportResources.HeadlineStock<span class="icon-sort-arrow"></span></th>
                <th class="text-right">@ReportResources.HeadlineStockPercent<span class="icon-sort-arrow"></span></th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {
            var total = Model.GrandTotal;
            <tr class="total">
                <td class="text-left">@ReportResources.Total</td>
                @HtmlHelpers.RenderNumberCell(total.Wagers, "text-right")
                @HtmlHelpers.RenderNumberCell(total.Stake, "text-right")
                @HtmlHelpers.RenderNumberCell(total.ValidStake, "text-right")
                @HtmlHelpers.RenderNumberCell(total.MemberIncome, "text-right")
                @HtmlHelpers.RenderNumberCell(total.Agent, "text-right")
                @HtmlHelpers.RenderNumberCell(total.AgentResult, "text-right")
                @HtmlHelpers.RenderNumberCell(total.Master, "text-right")
                @HtmlHelpers.RenderNumberCell(total.Super, "text-right")
                @HtmlHelpers.RenderNumberCell(total.SuperIncome, "text-right")
                @HtmlHelpers.RenderNumberCell(total.SuperResult, "text-right")
                @HtmlHelpers.RenderNumberCell(total.SuperStock, "text-right")
                @if (Model.IsNotOwner)
                {
                    @HtmlHelpers.RenderNumberCell(100)
                    <td></td>
                    @HtmlHelpers.RenderNumberCell(total.HeadlineIncome, "text-right")
                    @HtmlHelpers.RenderNumberCell(total.HeadlineResult, "text-right")
                    @HtmlHelpers.RenderNumberCell(total.HeadlineStock, "text-right")
                    @HtmlHelpers.RenderNumberCell(100, "text-right")
                }
            </tr>

            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.Stake, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.ValidStake, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.MemberIncome, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.Agent, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.AgentResult, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.Master, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.Super, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.SuperIncome, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.SuperResult, "text-right")
                    @HtmlHelpers.RenderNumberCell(row.SuperStock, "text-right")
                    @if (Model.IsNotOwner)
                    {
                        @HtmlHelpers.RenderNumberCell(row.SuperStock / total.SuperStock * 100, "text-right")
                        @HtmlHelpers.RenderNumberCell(row.HeadlinePoss, "text-right")
                        @HtmlHelpers.RenderNumberCell(row.HeadlineIncome, "text-right")
                        @HtmlHelpers.RenderNumberCell(row.HeadlineResult, "text-right")
                        @HtmlHelpers.RenderNumberCell(row.HeadlineStock, "text-right")
                        @HtmlHelpers.RenderNumberCell(row.HeadlineStock / total.HeadlineStock * 100, "text-right")
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(Model.IsNotOwner ? "18" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>