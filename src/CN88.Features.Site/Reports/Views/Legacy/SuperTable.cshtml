@model ReportViewModel
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover" id="tbl-report">
    <thead>
        <tr>
            <th>@ReportResources.SMAUsername</th>
            <th>@ReportResources.Name</th>
            <th>@SharedResources.Wagers</th>
            <th>@SharedResources.Stake</th>
            <th>@ReportResources.ValidStake</th>
            <th>@ReportResources.MemberIncome</th>
            <th>@SharedResources.Agent</th>
            <th>@ReportResources.AgentResult</th>
            <th>@ReportResources.MasterAgent</th>
            <th>@SharedResources.SMA</th>
            <th>@ReportResources.SMAIncome</th>
            <th>@ReportResources.SMAResult</th>
            <th>@ReportResources.SMAStock</th>
            @if (Model.IsNotOwner)
            {
                <th>@ReportResources.SMAStockPercent</th>
                <th>@ReportResources.HeadlinePoss</th>
                <th>@ReportResources.HeadlineIncome</th>
                <th>@ReportResources.HeadlineResult</th>
                <th>@ReportResources.HeadlineStock</th>
                <th>@ReportResources.HeadlineStockPercent</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {
            var total = Model.GrandTotal;
            <tr class="total">
                <td>@ReportResources.Total</td>
                <td></td>
                @HtmlHelpers.RenderNumberCell(total.Wagers)
                @HtmlHelpers.RenderNumberCell(total.Stake)
                @HtmlHelpers.RenderNumberCell(total.ValidStake)
                @HtmlHelpers.RenderNumberCell(total.MemberIncome)
                @HtmlHelpers.RenderNumberCell(total.Agent)
                @HtmlHelpers.RenderNumberCell(total.AgentResult)
                @HtmlHelpers.RenderNumberCell(total.Master)
                @HtmlHelpers.RenderNumberCell(total.Super)
                @HtmlHelpers.RenderNumberCell(total.SuperIncome)
                @HtmlHelpers.RenderNumberCell(total.SuperResult)
                @HtmlHelpers.RenderNumberCell(total.SuperStock)
                @if (Model.IsNotOwner)
                {
                    @HtmlHelpers.RenderNumberCell(100)
                    <td></td>
                    @HtmlHelpers.RenderNumberCell(total.HeadlineIncome)
                    @HtmlHelpers.RenderNumberCell(total.HeadlineResult)
                    @HtmlHelpers.RenderNumberCell(total.HeadlineStock)
                    @HtmlHelpers.RenderNumberCell(100)
                }
            </tr>

            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td>@row.Username</td>
                    <td>@row.Name</td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(row.Stake)
                    @HtmlHelpers.RenderNumberCell(row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(row.Agent)
                    @HtmlHelpers.RenderNumberCell(row.AgentResult)
                    @HtmlHelpers.RenderNumberCell(row.Master)
                    @HtmlHelpers.RenderNumberCell(row.Super)
                    @HtmlHelpers.RenderNumberCell(row.SuperIncome)
                    @HtmlHelpers.RenderNumberCell(row.SuperResult)
                    @HtmlHelpers.RenderNumberCell(row.SuperStock)
                    @if (Model.IsNotOwner)
                    {
                        @HtmlHelpers.RenderNumberCell(row.SuperStock / total.SuperStock * 100)
                        @HtmlHelpers.RenderNumberCell(row.HeadlinePoss)
                        @HtmlHelpers.RenderNumberCell(row.HeadlineIncome)
                        @HtmlHelpers.RenderNumberCell(row.HeadlineResult)
                        @HtmlHelpers.RenderNumberCell(row.HeadlineStock)
                        @HtmlHelpers.RenderNumberCell(row.HeadlineStock / total.HeadlineStock * 100)
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(Model.IsNotOwner ? "19" : "13")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>