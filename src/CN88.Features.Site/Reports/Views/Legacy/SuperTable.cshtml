@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<table class="tbl-noborder tbl-report" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username">@ReportResources.SMAUsername</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Wagers">@ReportResources.Wagers</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Stake">@ReportResources.Stake</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="ValidStake">@ReportResources.ValidStake</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MemberIncome">@ReportResources.MemberIncome</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Agent">@ReportResources.Agent</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResult">@ReportResources.AgentResult</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MasterAgent">@ReportResources.MasterAgent</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMA">@ReportResources.SMA</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAIncome">@ReportResources.SMAIncome</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAResult">@ReportResources.SMAResult</th>
            <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAStock">@ReportResources.SMAStock</th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="SMAStockPercent">@ReportResources.SMAStockPercent</th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlinePoss">
                    @ReportResources.HeadlinePoss <span class="icon-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess"></span>
                </th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineIncome">@ReportResources.HeadlineIncome</th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineResult">@ReportResources.HeadlineResult</th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineStock">@ReportResources.HeadlineStock</th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="HeadlineStockPercent">@ReportResources.HeadlineStockPercent</th>
            }
        </tr>
        @if (Model.ReportData.Any())
        {
            <tr class="total">
                <th class="text-left">@ReportResources.Total</th>
                @HtmlHelpers.RenderHeaderNumberCell(total.Wagers)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Master)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Super)
                @HtmlHelpers.RenderHeaderNumberCell(total.SuperIncome)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperResult)
                @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperStock)
                @if (Model.IsNotOwner)
                {
                    @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineResult)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineStock)
                    @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                }
            </tr>
        }
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a class="downline-link" href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Stake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(divisor, row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Agent)
                    @HtmlHelpers.RenderNumberCell(divisor, row.AgentResult)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Master)
                    @HtmlHelpers.RenderNumberCell(divisor, row.Super)
                    @HtmlHelpers.RenderNumberCell(divisor, row.SuperIncome)
                    @HtmlHelpers.RenderNumberCell(divisor, row.SuperResult)
                    @HtmlHelpers.RenderNumberCell(divisor, row.SuperStock)
                    @if (Model.IsNotOwner)
                    {
                        @ReportHtmlHelpers.RenderStockPercentCell(row.SuperStock, total.SuperStock)
                        <td class="text-right">@row.HeadlinePoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, row.HeadlineIncome)
                        @HtmlHelpers.RenderNumberCell(divisor, row.HeadlineResult)
                        @HtmlHelpers.RenderNumberCell(divisor, row.HeadlineStock)
                        @ReportHtmlHelpers.RenderStockPercentCell(row.HeadlineStock, total.HeadlineStock)
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td class="profit-margin" colspan="@(Model.IsNotOwner ? "18" : "12")" align="right"><strong>@ReportResources.ProfitMagin</strong> <strong>@HtmlHelpers.FormatNumber(Model.ProfitMargin) %</strong></td>
            </tr>
        </tfoot>
    }
    else
    {
        <tbody>
            <tr>
                <td colspan="@(Model.IsNotOwner ? "18" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
</table>