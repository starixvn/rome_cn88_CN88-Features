@model ReportViewModel
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover" id="tbl-report">
    <thead>
        <tr>
            <th>@ReportResources.MemberUsername</th>
            <th>@ReportResources.Name</th>
            <th>@SharedResources.Wagers</th>
            <th>@SharedResources.Stake</th>
            <th>@ReportResources.ValidStake</th>
            <th>@ReportResources.MemberIncome</th>
            <th>@ReportResources.AgentPoss</th>
            <th>@ReportResources.AgentIncome</th>
            <th>@ReportResources.AgentResultA</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {
            var total = Model.GrandTotal;
            <tr class="total">
                <td>@ReportResources.Total</td>
                <td></td>
                <td>@total.Wagers</td>
                <td>@total.Stake</td>
                <td>@total.ValidStake</td>
                <td>@total.MemberIncome</td>
                <td></td>
                <td>@total.AgentIncome</td>
                <td>@total.AgentResult</td>
            </tr>

            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td>@row.Username</td>
                    <td>@row.Name</td>
                    <td>@row.Wagers</td>
                    <td>@row.Stake</td>
                    <td>@row.ValidStake</td>
                    <td>@row.MemberIncome</td>
                    <td>@row.AgentPoss</td>
                    <td>@row.AgentIncome</td>
                    <td>@row.AgentResult</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>