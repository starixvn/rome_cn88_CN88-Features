@model ReportViewModel
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover" id="tbl-report">
    <thead>
        <tr>
            <th>@ReportResources.MAUsername</th>
            <th>@ReportResources.Name</th>
            <th>@SharedResources.Wagers</th>
            <th>@SharedResources.Stake</th>
            <th>@ReportResources.ValidStake</th>
            <th>@ReportResources.MemberIncome</th>
            <th>@SharedResources.Agent</th>
            <th>@ReportResources.AgentResult</th>
            <th>@ReportResources.MAPoss</th>
            <th>@ReportResources.MAResult</th>
            @if (Model.IsNotOwner)
            {
                <th>@SharedResources.SMA</th>
            }
            <th>@ReportResources.MAStock</th>
            <th>@ReportResources.MAStockPercent</th>
            @if (Model.IsNotOwner)
            {
                <th>@ReportResources.SMAIncome</th>
                <th>@ReportResources.SMAPoss</th>
                <th>@ReportResources.SMAResult</th>
                <th>@ReportResources.SMAStock</th>
                <th>@ReportResources.SMAStockPercent</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {
            var total = Model.GrandTotal;
            <tr class="total">
                <td>@ReportResources.Total</td>
                <td></td>
                <td>@total.Wagers</td>
                <td>@total.Stake</td>
                <td>@total.ValidStake</td>
                <td>@total.MemberIncome</td>
                <td>@total.Agent</td>
                <td>@total.AgentResult</td>
                <td>@total.MasterIncome</td>
                <td>@total.MasterResult</td>
                @if (Model.IsNotOwner)
                {
                    <td>@total.Super</td>
                }
                <td>@total.MasterStock</td>
                <td>100.00</td>
                @if (Model.IsNotOwner)
                {
                    <td></td>
                    <td>@total.SuperIncome</td>
                    <td>@total.SuperResult</td>
                    <td>@total.SuperStock</td>
                    <td>100.00</td>
                }
            </tr>

            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td>@row.Username</td>
                    <td>@row.Name</td>
                    <td>@row.Wagers</td>
                    <td>@row.Stake</td>
                    <td>@row.ValidStake</td>
                    <td>@row.MemberIncome</td>
                    <td>@row.Agent</td>
                    <td>@row.AgentResult</td>
                    <td>@row.MasterIncome</td>
                    <td>@row.MasterResult</td>
                    @if (Model.IsNotOwner)
                    {
                        <td>@row.Super</td>
                    }
                    <td>@row.MasterStock</td>
                    <td>@(row.MasterStock / total.MasterStock * 100)</td>
                    @if (Model.IsNotOwner)
                    {
                        <td>@row.SuperPoss</td>
                        <td>@row.SuperIncome</td>
                        <td>@row.SuperResult</td>
                        <td>@row.SuperStock</td>
                        <td>@(row.SuperStock / total.SuperStock * 100)</td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(Model.IsNotOwner ? "18" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>