@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
}
<table class="tbl-noborder tbl-report" id="tbl-report">
    <thead>
        <tr>
            <th class="text-left">@ReportResources.MAUsername</th>
            <th class="text-left">@ReportResources.Name</th>
            <th class="text-right">@ReportResources.Wagers</th>
            <th class="text-right">@ReportResources.Stake</th>
            <th class="text-right">@ReportResources.ValidStake</th>
            <th class="text-right">@ReportResources.MemberIncome</th>
            <th class="text-right">@ReportResources.Agent</th>
            <th class="text-right">@ReportResources.AgentResult</th>
            <th class="text-right">@ReportResources.MAPoss</th>
            <th class="text-right">@ReportResources.MAResult</th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right">@ReportResources.SMA</th>
            }
            <th class="text-right">@ReportResources.MAStock</th>
            <th class="text-right">@ReportResources.MAStockPercent</th>
            @if (Model.IsNotOwner)
            {
                <th class="text-right">@ReportResources.SMAIncome</th>
                <th class="text-right">@ReportResources.SMAPoss</th>
                <th class="text-right">@ReportResources.SMAResult</th>
                <th class="text-right">@ReportResources.SMAStock</th>
                <th class="text-right">@ReportResources.SMAStockPercent</th>
            }
        </tr>
        @if (Model.ReportData.Any())
        {
            <tr class="total">
                <th class="text-left">@ReportResources.Total</th>
                <th></th>
                @HtmlHelpers.RenderHeaderNumberCell(total.Wagers)
                @HtmlHelpers.RenderHeaderNumberCell(total.Stake)
                @HtmlHelpers.RenderHeaderNumberCell(total.ValidStake)
                @HtmlHelpers.RenderHeaderNumberCell(total.MemberIncome)
                @HtmlHelpers.RenderHeaderNumberCell(total.Agent)
                @HtmlHelpers.RenderHeaderNumberCell(total.AgentResult)
                @HtmlHelpers.RenderHeaderNumberCell(total.MasterIncome)
                @HtmlHelpers.RenderHeaderNumberCell(total.MasterResult)
                @if (Model.IsNotOwner)
                {
                    @HtmlHelpers.RenderHeaderNumberCell(total.Super)
                }
                @HtmlHelpers.RenderHeaderNumberCell(total.MasterStock)
                @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                @if (Model.IsNotOwner)
                {
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(total.SuperIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(total.SuperResult)
                    @HtmlHelpers.RenderHeaderNumberCell(total.SuperStock)
                    @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                }
            </tr>
        }
    </thead>
    <tbody>
        @if (Model.ReportData.Any())
        {
            foreach (var row in Model.ReportData)
            {
                <tr>
                    <td><a href="@Model.BuildDrillDownLink(row, Request.Url.Query)">@row.Username</a></td>
                    <td class="text-left">@row.Name</td>
                    @HtmlHelpers.RenderNumberCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(row.Stake)
                    @HtmlHelpers.RenderNumberCell(row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(row.Agent)
                    @HtmlHelpers.RenderNumberCell(row.AgentResult)
                    @HtmlHelpers.RenderNumberCell(row.MasterIncome)
                    @HtmlHelpers.RenderNumberCell(row.MasterResult)
                    @if (Model.IsNotOwner)
                    {
                        @HtmlHelpers.RenderNumberCell(row.Super)
                    }
                    @HtmlHelpers.RenderNumberCell(row.MasterStock)
                    @ReportHtmlHelpers.RenderStockPercentCell(row.MasterStock, total.MasterStock)
                    @if (Model.IsNotOwner)
                    {
                        <td class="text-right">@row.SuperPoss</td>
                        @HtmlHelpers.RenderNumberCell(row.SuperIncome)
                        @HtmlHelpers.RenderNumberCell(row.SuperResult)
                        @HtmlHelpers.RenderNumberCell(row.SuperStock)
                        @ReportHtmlHelpers.RenderStockPercentCell(row.SuperStock, total.SuperStock)
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(Model.IsNotOwner ? "18" : "12")" align="center">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>
</table>