@model ReportBaseViewModel
<div id="settlement-content" class="tab-content">
    <table class="tbl-style2 tbl-report settlement-report">
        <thead>
            <tr>
                <th class="">@ReportResources.AgentUsername</th>
                <th class="">@ReportResources.Name</th>
                <th class="valid-stake">@ReportResources.Agent</th>
                <th class="valid-stake">@ReportResources.AgentPoss</th>
                <th class="valid-stake">@ReportResources.AgentIncome</th>
                <th class="valid-stake">@ReportResources.AgentResult</th>
                <th class="valid-stake">@ReportResources.AgentStock</th>
                @if (Model.IsNotOwner)
                {
                    <th class="valid-stake">@ReportResources.MAPoss</th>
                    <th class="valid-stake">@ReportResources.MAIncome</th>
                    <th class="valid-stake">@ReportResources.MAResult</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                var total = Model.GrandTotal;
                <tr class="total">
                    <td class="text-left">@ReportResources.Total</td>
                    <td></td>
                    @HtmlHelpers.RenderNumberCell(total.Agent)
                    <td></td>
                    @HtmlHelpers.RenderNumberCell(total.AgentIncome)
                    @HtmlHelpers.RenderNumberCell(total.AgentResult)
                    @HtmlHelpers.RenderNumberCell(total.AgentStock)
                    @if (Model.IsNotOwner)
                    {
                        <td></td>
                        @HtmlHelpers.RenderNumberCell(total.MasterIncome)
                        @HtmlHelpers.RenderNumberCell(total.MasterResult)
                    }
                </tr>
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(data.Agent)
                        <td class="text-right">@data.AgentPoss</td>
                        @HtmlHelpers.RenderNumberCell(data.AgentIncome)
                        @HtmlHelpers.RenderNumberCell(data.AgentResult)
                        @HtmlHelpers.RenderNumberCell(data.AgentStock)
                        @if (Model.IsNotOwner)
                        {
                            <td class="text-right">@data.MasterPoss</td>
                            @HtmlHelpers.RenderNumberCell(data.MasterIncome)
                            @HtmlHelpers.RenderNumberCell(data.MasterResult)
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div id="valid-stake-content" class="tab-content display-none">
    <table class="tbl-style2 tbl-report valid-stake-report">
        <thead>
            <tr>
                <th class="">@ReportResources.AgentUsername</th>
                <th class="">@ReportResources.Name</th>
                <th class="valid-stake">@ReportResources.Wagers</th>
                <th class="valid-stake">@ReportResources.Stake</th>
                <th class="valid-stake">@ReportResources.ValidStake</th>
                <th class="valid-stake">@ReportResources.MemberIncome</th>
                <th class="valid-stake">@ReportResources.AgentCurrency</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                var total = Model.GrandTotal;
                <tr class="total">
                    <td class="text-left">@ReportResources.Total</td>
                    <td></td>
                    @HtmlHelpers.RenderNumberCell(total.Wagers)
                    @HtmlHelpers.RenderNumberCell(total.Stake)
                    @HtmlHelpers.RenderNumberCell(total.ValidStake)
                    @HtmlHelpers.RenderNumberCell(total.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(total.AgentCurrency)
                </tr>
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(data.Wagers)
                        @HtmlHelpers.RenderNumberCell(data.Stake)
                        @HtmlHelpers.RenderNumberCell(data.ValidStake)
                        @HtmlHelpers.RenderNumberCell(data.MemberIncome)
                        @HtmlHelpers.RenderNumberCell(data.AgentCurrency)
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>