@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    int divisor = Model.Divisor;
    var colIndex = 0;
}
<div class="tab-content">
    <table class="tbl-noborder tbl-report" id="tbl-report"
           data-totalrecords="@Model.ReportData.Count()"
           data-sortedcolumn="@Model.SortPropertyName"
           data-descendingsort="@Model.IsDescendingSort">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username"><span class="sorting-item">@ReportResources.AgentUsername</span></th>
                <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Name"><span class="sorting-item">@ReportResources.Name</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="Agent"><span class="sorting-item">@ReportResources.Agent</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentPoss"><span class="sorting-item">@ReportResources.AgentPoss</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentIncome"><span class="sorting-item">@ReportResources.AgentIncome</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResult"><span class="sorting-item">@ReportResources.AgentResult</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentStock"><span class="sorting-item">@ReportResources.AgentStock</span></th>
                @if (Model.IsNotOwner)
                {
                    <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="MAPoss">
                        <span class="sorting-item more-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess">@ReportResources.MAPoss</span>
                    </th>
                    <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="MAIncome"><span class="sorting-item">@ReportResources.MAIncome</span></th>
                    <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="MAResult"><span class="sorting-item">@ReportResources.MAResult</span></th>
                }
                <th class="text-right valid-stake header sorting" data-colindex="@(colIndex++)" data-sortedname="Wagers"><span class="sorting-item">@ReportResources.Wagers</span></th>
                <th class="text-right valid-stake header sorting" data-colindex="@(colIndex++)" data-sortedname="Stake"><span class="sorting-item">@ReportResources.Stake</span></th>
                <th class="text-right valid-stake header sorting" data-colindex="@(colIndex++)" data-sortedname="ValidStake"><span class="sorting-item">@ReportResources.ValidStake</span></th>
                <th class="text-right valid-stake header sorting" data-colindex="@(colIndex++)" data-sortedname="MemberIncome"><span class="sorting-item">@ReportResources.MemberIncome</span></th>
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent, "settlement")
                    <th class="settlement"></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentIncome, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentStock, "settlement")
                    @if (Model.IsNotOwner)
                    {
                        <th class="settlement"></th>
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterIncome, "settlement")
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterResult, "settlement")
                    }
                    @HtmlHelpers.RenderHeaderNumberCell(total.Wagers, "valid-stake")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake, "valid-stake")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake, "valid-stake")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome, "valid-stake")
                </tr>
            }
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a class="downline-link" href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(divisor, data.Agent, "settlement")
                        <td class="text-right settlement">@data.AgentPoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentIncome, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentResult, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentStock, "settlement")
                        @if (Model.IsNotOwner)
                        {
                            <td class="text-right settlement">@data.MasterPoss</td>
                            @HtmlHelpers.RenderNumberCell(divisor, data.MasterIncome, "settlement")
                            @HtmlHelpers.RenderNumberCell(divisor, data.MasterResult, "settlement")
                        }
                        @HtmlHelpers.RenderNumberCell(data.Wagers, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Stake, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.ValidStake, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.MemberIncome, "valid-stake")
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(Model.IsSettlement?(Model.IsNotOwner?"10":"7"):"6")" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>