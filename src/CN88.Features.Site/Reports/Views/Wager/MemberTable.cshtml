@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<div class="tab-content">
    <table class="tbl-noborder tbl-report" id="tbl-report"
           data-totalrecords="@Model.ReportData.Count()"
           data-sortedcolumn="@Model.SortPropertyName"
           data-descendingsort="@Model.IsDescendingSort">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username"><span class="sorting-item">@ReportResources.MemberUsername</span></th>
                <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Name"><span class="sorting-item">@ReportResources.Name</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="Wagers"><span class="sorting-item">@ReportResources.Wagers</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="Stake"><span class="sorting-item">@ReportResources.Stake</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="ValidStake"><span class="sorting-item">@ReportResources.ValidStake</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="MemberIncome"><span class="sorting-item">@ReportResources.MemberIncome</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentPoss">
                    <span class="sorting-item more-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess">@ReportResources.AgentPoss</span>
                </th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentIncome"><span class="sorting-item">@ReportResources.AgentIncome</span></th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResultA"><span class="sorting-item">@ReportResources.AgentResultA</span></th>
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    <th></th>
                    @HtmlHelpers.RenderHeaderNumberCell(total.Wagers, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome, "settlement")
                    <th class="settlement"></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentIncome, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult, "settlement")
                </tr>
            }
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a class="downline-link" href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(data.Wagers, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Stake, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.ValidStake, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.MemberIncome, "settlement")
                        <td class="text-right settlement">@data.AgentPoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentIncome, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentResult, "settlement")
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>