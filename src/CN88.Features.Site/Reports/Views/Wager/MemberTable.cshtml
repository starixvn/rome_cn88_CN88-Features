@model ReportViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<div class="tab-content">
    <table class="tbl-noborder tbl-report" id="tbl-report"
           data-totalrecords="@Model.ReportData.Count()"
           data-sortedcolumn="@Model.SortPropertyName"
           data-descendingsort="@Model.IsDescendingSort"
           data-isMobile="@Model.IsMobile.ToString().ToLower()">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username">@ReportResources.MemberUsername</th>
                <th class="text-left header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Name">@ReportResources.Name</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Wagers">@ReportResources.Wagers</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Stake">@ReportResources.Stake</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="ValidStake">@ReportResources.ValidStake</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="MemberIncome">@ReportResources.MemberIncome</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="AgentPoss">
                    @ReportResources.AgentPoss <span class="icon-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess"></span>
                </th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="AgentIncome">@ReportResources.AgentIncome</th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResultA">@ReportResources.AgentResultA</th>
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    <th data-stack-column="true"></th>
                    @HtmlHelpers.RenderHeaderNumberCell(total.Wagers, "settlement", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake, "settlement", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake, "settlement", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome, "settlement", true)
                    <th class="settlement" data-stack-column="true"></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentIncome, "settlement", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult, "settlement")
                </tr>
            }
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a class="downline-link" href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(data.Wagers, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Stake, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.ValidStake, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.MemberIncome, "settlement")
                        <td class="text-right settlement">@data.AgentPoss</td>
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentIncome, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentResult, "settlement")
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" align="center" data-isNoInfo="true">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>