@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
}
<div id="settlement-content" class="tab-content">
    <table class="tbl-noborder tbl-report settlement-report">
        <thead>
            <tr>
                <th class="text-left">@ReportResources.SMAUsername</th>
                <th class="text-right valid-stake">@ReportResources.SMA</th>
                <th class="text-right valid-stake">@ReportResources.SMAIncome</th>
                <th class="text-right valid-stake">@ReportResources.SMAResult</th>
                <th class="text-right valid-stake">@ReportResources.SMAStock</th>
                @if (Model.IsNotOwner)
                {
                    <th class="text-right valid-stake">@ReportResources.SMAStockPercent</th>
                    <th class="text-right valid-stake">@ReportResources.HeadlinePoss</th>
                    <th class="text-right valid-stake">@ReportResources.HeadlineIncome</th>
                    <th class="text-right valid-stake">@ReportResources.HeadlineResult</th>
                    <th class="text-right valid-stake">@ReportResources.HeadlineStock</th>
                    <th class="text-right valid-stake">@ReportResources.HeadlineStockPercent</th>
                }
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    @HtmlHelpers.RenderHeaderNumberCell(total.Super)
                    @HtmlHelpers.RenderHeaderNumberCell(total.SuperIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(total.SuperResult)
                    @HtmlHelpers.RenderHeaderNumberCell(total.SuperStock)
                    @if (Model.IsNotOwner)
                    {
                        @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                        <th></th>
                        @HtmlHelpers.RenderHeaderNumberCell(total.HeadlineIncome)
                        @HtmlHelpers.RenderHeaderNumberCell(total.HeadlineResult)
                        @HtmlHelpers.RenderHeaderNumberCell(total.HeadlineStock)
                        @ReportHtmlHelpers.RenderHeaderPercentCell(100)
                    }
                </tr>
            }
        </thead>
        @if (Model.ReportData.Any())
        {
            <tbody>
                @foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        @HtmlHelpers.RenderNumberCell(data.Super)
                        @HtmlHelpers.RenderNumberCell(data.SuperIncome)
                        @HtmlHelpers.RenderNumberCell(data.SuperResult)
                        @HtmlHelpers.RenderNumberCell(data.SuperStock)
                        @if (Model.IsNotOwner)
                        {
                            @ReportHtmlHelpers.RenderStockPercentCell(data.SuperStock, total.SuperStock)
                            <td class="text-right">@data.HeadlinePoss</td>
                            @HtmlHelpers.RenderNumberCell(data.HeadlineIncome)
                            @HtmlHelpers.RenderNumberCell(data.HeadlineResult)
                            @HtmlHelpers.RenderNumberCell(data.HeadlineStock)
                            @ReportHtmlHelpers.RenderStockPercentCell(data.HeadlineStock, total.HeadlineStock)
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="profit-margin" colspan="5" align="right"><strong>@ReportResources.ProfitMagin</strong> <strong>@HtmlHelpers.FormatNumber(Model.ProfitMargin) %</strong></td>
                </tr>
            </tfoot>
        }
        else
        {
            <tbody>
                <tr>
                    <td colspan="6" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            </tbody>
        }
    </table>
</div>
<div id="valid-stake-content" class="tab-content display-none">
    <table class="tbl-noborder tbl-report valid-stake-report">
        <thead>
            <tr>
                <th class="text-left">@ReportResources.SMAUsername</th>
                <th class="text-right valid-stake">@ReportResources.Wagers</th>
                <th class="text-right valid-stake">@ReportResources.Stake</th>
                <th class="text-right valid-stake">@ReportResources.ValidStake</th>
                <th class="text-right valid-stake">@ReportResources.MemberIncome</th>
                <th class="text-right valid-stake">@ReportResources.Agent</th>
                <th class="text-right valid-stake">@ReportResources.AgentResult</th>
                <th class="text-right valid-stake">@ReportResources.MasterAgent</th>
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    @HtmlHelpers.RenderHeaderNumberCell(total.Wagers)
                    @HtmlHelpers.RenderHeaderNumberCell(total.Stake)
                    @HtmlHelpers.RenderHeaderNumberCell(total.ValidStake)
                    @HtmlHelpers.RenderHeaderNumberCell(total.MemberIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(total.Agent)
                    @HtmlHelpers.RenderHeaderNumberCell(total.AgentResult)
                    @HtmlHelpers.RenderHeaderNumberCell(total.Master)
                </tr>
            }
        </thead>
        @if (Model.ReportData.Any())
        {
            <tbody>
                @foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        @HtmlHelpers.RenderNumberCell(data.Wagers)
                        @HtmlHelpers.RenderNumberCell(data.Stake)
                        @HtmlHelpers.RenderNumberCell(data.ValidStake)
                        @HtmlHelpers.RenderNumberCell(data.MemberIncome)
                        @HtmlHelpers.RenderNumberCell(data.Agent)
                        @HtmlHelpers.RenderNumberCell(data.AgentResult)
                        @HtmlHelpers.RenderNumberCell(data.Master)
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="profit-margin" colspan="8" align="right"><strong>@ReportResources.ProfitMagin</strong> <strong>@HtmlHelpers.FormatNumber(Model.ProfitMargin) %</strong></td>
                </tr>
            </tfoot>
        }
        else
        {
            <tbody>
                <tr>
                    <td colspan="8" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            </tbody>
        }
    </table>
</div>