@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<div class="tab-content main-content" id="tab-main-content">
    <table class="tbl-noborder tbl-report settlement-report" id="tbl-report"
        data-totalrecords="@Model.ReportData.Count()"
        data-sortedcolumn="@Model.SortPropertyName"
        data-descendingsort="@Model.IsDescendingSort"
        data-isMobile="@Model.IsMobile.ToString().ToLower()">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th class="text-left header sorting username" data-colindex="@(colIndex++)" data-sortedname="Username">@ReportResources.SMAUsername</th>
                <th class="text-right settlement header sorting" data-stack-show-in-body="true" data-colindex="@(colIndex++)" data-sortedname="SMA">@ReportResources.SMA</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="SMAIncome">@ReportResources.SMAIncome</th>
                <th class="text-right settlement header sorting" data-stack-show-in-body="true" data-colindex="@(colIndex++)" data-sortedname="SMAResult">@ReportResources.SMAResult</th>
                <th class="text-right settlement header sorting" data-stack-show-in-body="true" data-colindex="@(colIndex++)" data-sortedname="SMAStock">@ReportResources.SMAStock</th>
                @if (Model.IsNotOwner)
                {
                    <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="SMAStockPercent">@ReportResources.SMAStockPercent</th>
                    <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="HeadlinePoss">
                        @ReportResources.HeadlinePoss <span class="icon-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess"></span>
                    </th>
                    <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="HeadlineIncome">@ReportResources.HeadlineIncome</th>
                    <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="HeadlineResult">@ReportResources.HeadlineResult</th>
                    <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="HeadlineStock">@ReportResources.HeadlineStock</th>
                    <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="HeadlineStockPercent">@ReportResources.HeadlineStockPercent</th>
                }
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Wagers">@ReportResources.Wagers</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Stake">@ReportResources.Stake</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="ValidStake">@ReportResources.ValidStake</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="MemberIncome">@ReportResources.MemberIncome</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Agent">@ReportResources.Agent</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="AgentResult">@ReportResources.AgentResult</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="MasterAgent">@ReportResources.MasterAgent</th>
            </tr>
            @if (Model.IsShowTotalRow())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Super, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperIncome, "settlement", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperResult, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperStock, "settlement")
                    @if (Model.IsNotOwner)
                    {
                        @ReportHtmlHelpers.RenderHeaderPercentCell(Model.TotalStockPercent, "settlement", true)
                        <th class="settlement"></th>
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineIncome, "settlement", true)
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineResult, "settlement", true)
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.HeadlineStock, "settlement", true)
                        @ReportHtmlHelpers.RenderHeaderPercentCell(Model.TotalStockPercent, "settlement", true)
                    }
                    @HtmlHelpers.RenderHeaderNumberCell(total.Wagers, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Master, "valid-stake", true)
                </tr>
            }
        </thead>
        @if (Model.ReportData.Any())
        {
            <tbody>
                @foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td class="username"><a class="downline-link" href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        @HtmlHelpers.RenderNumberCell(divisor, data.Super, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.SuperIncome, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.SuperResult, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.SuperStock, "settlement")
                        @if (Model.IsNotOwner)
                        {
                            @ReportHtmlHelpers.RenderStockPercentCell(data.SuperStock, total.SuperStock, "settlement")
                            <td class="text-right settlement">@data.HeadlinePoss</td>
                            @HtmlHelpers.RenderNumberCell(divisor, data.HeadlineIncome, "settlement")
                            @HtmlHelpers.RenderNumberCell(divisor, data.HeadlineResult, "settlement")
                            @HtmlHelpers.RenderNumberCell(divisor, data.HeadlineStock, "settlement")
                            @ReportHtmlHelpers.RenderStockPercentCell(data.HeadlineStock, total.HeadlineStock, "settlement")
                        }
                        @HtmlHelpers.RenderNumberCell(data.Wagers, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Stake, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.ValidStake, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.MemberIncome, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Agent, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentResult, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Master, "valid-stake")
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td id="profit-margin" class="profit-margin" colspan="@(Model.IsSettlement? (Model.IsNotOwner?"11":"5"):"8")" align="right"><strong>@ReportResources.ProfitMagin</strong> <strong>@HtmlHelpers.FormatNumber(Model.ProfitMargin) %</strong></td>
                </tr>
            </tfoot>
        }
        else
        {
            <tbody>
                <tr>
                    <td colspan="@(Model.IsSettlement? (Model.IsNotOwner?"11":"5"):"8")"
                        data-isNoInfo="true"
                        align="center">
                    @SharedResources.NoInformationIsAvailable
                    </td>
                </tr>
            </tbody>
        }
    </table>
</div>