@model ReportBaseViewModel
@{
    var total = Model.GrandTotal;
    int divisor = Model.Divisor;
}
<div id="settlement-content" class="tab-content">
    <table class="tbl-noborder tbl-report settlement-report"  id="tbl-report">
        <thead>
            <tr>
                <th class="text-left">@ReportResources.MAUsername</th>
                <th class="text-left" data-stack-column="true">@ReportResources.Name</th>
                <th class="text-right" data-stack-column="true" valid-stake">@ReportResources.MAIncome</th>
                <th class="text-right valid-stake">@ReportResources.MAResult</th>
                <th class="text-right valid-stake">@ReportResources.MAStock</th>
                <th class="text-right valid-stake">@ReportResources.MAStockPercent</th>
                @if (Model.IsNotOwner)
                {
                    <th class="text-right valid-stake">@ReportResources.SMA</th>
                    <th class="text-right valid-stake">@ReportResources.SMAPoss</th>
                    <th class="text-right valid-stake">@ReportResources.SMAIncome</th>
                    <th class="text-right valid-stake">@ReportResources.SMAResult</th>
                    <th class="text-right valid-stake">@ReportResources.SMAStock</th>
                    <th class="text-right valid-stake">@ReportResources.SMAStockPercent</th>
                }
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    <th data-stack-column="true"></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterIncome, isHiddenOnMobile: true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterResult)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterStock)
                    @ReportHtmlHelpers.RenderHeaderPercentCell(Model.TotalStockPercent)
                    @if (Model.IsNotOwner)
                    {
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Super)
                        <th></th>
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperIncome)
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperResult)
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperStock)
                        @ReportHtmlHelpers.RenderHeaderPercentCell(Model.TotalStockPercent)
                    }
                </tr>
            }
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a href="@Model.BuildDrillDownLink(data, Request.Url.Query, true)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(divisor, data.MasterIncome)
                        @HtmlHelpers.RenderNumberCell(divisor, data.MasterResult)
                        @HtmlHelpers.RenderNumberCell(divisor, data.MasterStock)
                        @ReportHtmlHelpers.RenderStockPercentCell(data.MasterStock, total.MasterStock)
                        @if (Model.IsNotOwner)
                        {
                            @HtmlHelpers.RenderNumberCell(divisor, data.Super)
                            <td class="text-right">@data.SuperPoss</td>
                            @HtmlHelpers.RenderNumberCell(divisor, data.SuperIncome)
                            @HtmlHelpers.RenderNumberCell(divisor, data.SuperResult)
                            @HtmlHelpers.RenderNumberCell(divisor, data.SuperStock)
                            @ReportHtmlHelpers.RenderStockPercentCell(data.SuperStock, total.SuperStock)
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(Model.IsNotOwner?"12":"6")" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div id="valid-stake-content" class="tab-content display-none">
    <table class="tbl-noborder tbl-report valid-stake-report">
        <thead>
            <tr>
                <th class="text-left">@ReportResources.MAUsername</th>
                <th class="text-left"  data-stack-column="true">@ReportResources.Name</th>
                <th class="text-right valid-stake">@ReportResources.Wagers</th>
                <th class="text-right valid-stake">@ReportResources.Stake</th>
                <th class="text-right valid-stake">@ReportResources.ValidStake</th>
                <th class="text-right valid-stake">@ReportResources.MemberIncome</th>
                <th class="text-right valid-stake">@ReportResources.Agent</th>
                <th class="text-right valid-stake">@ReportResources.AgentResult</th>
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    <th data-stack-column="true"></th>
                    @HtmlHelpers.RenderHeaderNumberCell(total.Wagers)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult)
                </tr>
            }
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(data.Wagers)
                        @HtmlHelpers.RenderNumberCell(divisor, data.Stake)
                        @HtmlHelpers.RenderNumberCell(divisor, data.ValidStake)
                        @HtmlHelpers.RenderNumberCell(divisor, data.MemberIncome)
                        @HtmlHelpers.RenderNumberCell(divisor, data.Agent)
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentResult)
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>