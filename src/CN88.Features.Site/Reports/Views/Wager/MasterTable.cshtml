@model ReportViewModel
@{
    var total = Model.GrandTotal;
    var divisor = Model.Divisor;
    var colIndex = 0;
}
<div class="tab-content">
    <table class="tbl-noborder tbl-report settlement-report"  id="tbl-report"
           data-totalrecords="@Model.ReportData.Count()"
           data-sortedcolumn="@Model.SortPropertyName"
           data-descendingsort="@Model.IsDescendingSort"
           data-isMobile="@Model.IsMobile.ToString().ToLower()">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="Username">@ReportResources.MAUsername</th>
                <th class="text-left header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Name">@ReportResources.Name</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="MAIncome">@ReportResources.MAIncome</th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="MAResult">@ReportResources.MAResult</th>
                <th class="text-right settlement header sorting" data-colindex="@(colIndex++)" data-sortedname="MAStock">@ReportResources.MAStock</th>
                <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="MAStockPercent">@ReportResources.MAStockPercent</th>
                @if (Model.IsNotOwner)
                {
                    <th class="text-right settlement header sorting" data-stack-column="true"  data-colindex="@(colIndex++)" data-sortedname="SMA">@ReportResources.SMA</th>
                    <th class="text-right settlement header sorting" data-stack-column="true"  data-colindex="@(colIndex++)" data-sortedname="SMAPoss">
                        @ReportResources.SMAPoss <span class="icon-info" data-toggle="tooltip" title="@ReportResources.SportsbookPossess / @ReportResources.NonSportsProductPossess"></span>
                    </th>
                    <th class="text-right settlement header sorting" data-stack-column="true"  data-colindex="@(colIndex++)" data-sortedname="SMAIncome">@ReportResources.SMAIncome</th>
                    <th class="text-right settlement header sorting" data-stack-column="true"  data-colindex="@(colIndex++)" data-sortedname="SMAResult">@ReportResources.SMAResult</th>
                    <th class="text-right settlement header sorting" data-stack-column="true"  data-colindex="@(colIndex++)" data-sortedname="SMAStock">@ReportResources.SMAStock</th>
                    <th class="text-right settlement header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="SMAStockPercent">@ReportResources.SMAStockPercent</th>
                }
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Wagers">@ReportResources.Wagers</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Stake">@ReportResources.Stake</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Stake">@ReportResources.ValidStake</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="MemberIncome">@ReportResources.MemberIncome</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="Agent">@ReportResources.Agent</th>
                <th class="text-right valid-stake header sorting" data-stack-column="true" data-colindex="@(colIndex++)" data-sortedname="AgentResult">@ReportResources.AgentResult</th>
            </tr>
            @if (Model.ReportData.Any())
            {
                <tr class="total">
                    <th class="text-left">@ReportResources.Total</th>
                    <th data-stack-column="true"></th>
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterIncome, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterResult, "settlement")
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MasterStock, "settlement", true)
                    @ReportHtmlHelpers.RenderHeaderPercentCell(Model.TotalStockPercent, "settlement", true)
                    @if (Model.IsNotOwner)
                    {
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Super, "settlement", true)
                        <th class="settlement" data-stack-column="true"></th>
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperIncome, "settlement", true)
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperResult, "settlement", true)
                        @HtmlHelpers.RenderHeaderNumberCell(divisor, total.SuperStock, "settlement", true)
                        @ReportHtmlHelpers.RenderHeaderPercentCell(Model.TotalStockPercent, "settlement", true)
                    }
                    @HtmlHelpers.RenderHeaderNumberCell(total.Wagers, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Stake, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.ValidStake, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.MemberIncome, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.Agent, "valid-stake", true)
                    @HtmlHelpers.RenderHeaderNumberCell(divisor, total.AgentResult, "valid-stake", true)
                </tr>
            }
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td><a class="downline-link" href="@Model.BuildDrillDownLink(data, Request.Url.Query)">@data.Username</a></td>
                        <td class="text-left">@data.Name</td>
                        @HtmlHelpers.RenderNumberCell(divisor, data.MasterIncome, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.MasterResult, "settlement")
                        @HtmlHelpers.RenderNumberCell(divisor, data.MasterStock, "settlement")
                        @ReportHtmlHelpers.RenderStockPercentCell(data.MasterStock, total.MasterStock, "settlement")
                        @if (Model.IsNotOwner)
                        {
                            @HtmlHelpers.RenderNumberCell(divisor, data.Super, "settlement")
                            <td class="text-right settlement">@data.SuperPoss</td>
                            @HtmlHelpers.RenderNumberCell(divisor, data.SuperIncome, "settlement")
                            @HtmlHelpers.RenderNumberCell(divisor, data.SuperResult, "settlement")
                            @HtmlHelpers.RenderNumberCell(divisor, data.SuperStock, "settlement")
                            @ReportHtmlHelpers.RenderStockPercentCell(data.SuperStock, total.SuperStock, "settlement")
                        }
                        @HtmlHelpers.RenderNumberCell(data.Wagers, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Stake, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.ValidStake, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.MemberIncome, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.Agent, "valid-stake")
                        @HtmlHelpers.RenderNumberCell(divisor, data.AgentResult, "valid-stake")
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(Model.IsSettlement?(Model.IsNotOwner?"12":"6"):"8")" align="center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>