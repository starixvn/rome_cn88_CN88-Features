@using CN88.Features.Site.Reports.ViewModels
@model MainViewModel
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover">
    <thead>
        <tr>
            <th colspan="2">@DateTime.Now.Year</th>
            <th colspan="2">@(DateTime.Now.Year - 1)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model.AccountingPeriodGroups)
        {
            <tr>
                @foreach (var period in group.Periods)
                {
                    <td>@period.PeriodId.</td>
                    <td>@period.FromDateStr ~ @period.ToDateStr</td>
                }
            </tr>
        }
    </tbody>
</table>