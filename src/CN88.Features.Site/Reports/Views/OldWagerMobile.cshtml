@{
    Layout = "~/Reports/Views/_OldLayout.cshtml";
    var backLink = Model.BuildBackLink();
}
@section Styles {
    @StaticResources.RenderStyles("~/Reports/bundles/reports")
}
@model OldReportViewModel
<div class="report-detail wager-report">
    <div class="page-title-mobile">
        <span id="btn-back" class="back-area">            
            <a href="@backLink.Link">
                <span class="icon-chevron-left back-step"></span>
                @backLink.Text
            </a>
        </span>

        <span class="icon-filter-down" id="filter-toggle-icon"></span>
    </div>
    @Html.Partial("~/Reports/Views/OldFilter.cshtml", Model.OldReportFilterViewModel,
    new ViewDataDictionary
    {
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName },
        { "IsSettlement", Model.IsSettlement }
    })
    @{
        if (Model.ReportLevel.IsSuperLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/SuperTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsMasterLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/MasterTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsAgentLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/AgentTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsMemberLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/MemberTable.cshtml", Model)
        }
    }
    @Pager.Render(Model.PagerViewModel)
    @Html.Hidden(nameof(Model.IsOwner), Model.IsOwner)
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/Reports/bundles/old-wager")
}