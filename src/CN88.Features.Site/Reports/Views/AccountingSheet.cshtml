@model AccountingSheetViewModel
@{ 
    var groupPeriod = Model.AccountingPeriodGroups.FirstOrDefault();
}
<table class="tbl-noborder tblAccountingSheet" id="tblAccountingSheet">
    <thead>
        <tr>
            <th>@groupPeriod.Year</th>
            <th>@(groupPeriod.Year - 1)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model.AccountingPeriodGroups)
        {
            <tr>
                @foreach (var period in group.Periods)
                {
                    var periodStr = string.IsNullOrWhiteSpace(period.FromDateStr) || 
                        string.IsNullOrWhiteSpace(period.FromDateStr) ? string.Empty :
                        $"{period.FromDateStr} ~ {period.ToDateStr}";
                    <td class="@(period.IsCurrentPeriod ? "current" : string.Empty)">
                        <span class="reportNo">@period.PeriodId.</span>@periodStr
                    </td>
                }
            </tr>
        }
    </tbody>
</table>