@using System.Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes" />
    <meta name="format-detection" content="telephone=no">
    <title>@ReportResources.OldReport</title>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      @StaticResources.AssetScripts.RenderCommon("/bundles/common/support-IE8")
    <![endif]-->
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-features/default")
    @RenderSection("Styles", required: false)
</head>
<body class="old-report">
    <div class="menubar">
        <section id="main-menu-tab" class="mainmenu-container">
            <ul class="list-menu" id="main-menu-items">
                <li class="menu-item active">
                    <a class="txt-item menu-opener parent-menu active" href="javascript:void(0);">@ReportResources.Reports</a>
                </li>
            </ul>
            <ul class="sub-menu">
                <li class="sub-menu-item">
                    <a id="sub-menu-wager" href="@AppPathHelper.GetAppPath(AppSettings.FeaturesAppPath, "~/OldReports/Index?DisplayMode=1")" class="redirect-item">@ReportResources.WagerReport</a>
                </li>
                <li class="sub-menu-item">
                    <a id="sub-menu-legacy" href="@AppPathHelper.GetAppPath(AppSettings.FeaturesAppPath, "~/OldReports/Index?DisplayMode=2")" class="redirect-item">@ReportResources.LegacyReport</a>
                </li>
            </ul>
        </section>
    </div>
    <main class="new-page-content" id="content">
        @RenderBody()
    </main>
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-features/default")
    @RenderSection("Scripts", required: false)
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
    @Html.Hidden("expiredSessionSeconds", ConfigurationManager.AppSettings["OldReports:ExpiredSessionSeconds"])
    @Html.Hidden("CheckinURL", AppPathHelper.GetAppPath(AppSettings.FeaturesAppPath, "~/OldReports/Checkin"))
</body>
</html>