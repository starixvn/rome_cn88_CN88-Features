@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@using CN88.Features.Site.Reports.ViewModels
@model MainViewModel
<div class="container-fluid">
    <div class="row">
        <div class="filter-container col-xs-12 col-sm-12 col-md-5">
            <div class="page-title">Create Report</div>
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active">
                    <a data-toggle="tab" href="#wagerReport">Wager report</a>
                </li>
                <li role="presentation">
                    <a data-toggle="tab" href="#cancelledReport">Cancelled report</a>
                </li>
            </ul>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade in active" id="wagerReport">
                    <form class="filter" role="form">
                        <div class="form-group">
                            <select>
                                @foreach (var type in Model.WagerReportTypes)
                                {
                                    <option value="@type.Value">@type.Text</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <input type="reset" value="Clear" />
                            <input type="submit" value="View Report" />
                        </div>
                    </form>
                </div>
                <div role="tabpanel" class="tab-pane fade" id="cancelledReport">
                </div>
            </div>
        </div>
        <div class="result-container col-xs-12 col-sm-12 col-md-5">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active">
                    <a data-toggle="tab" href="#settlementSumary">Settlement summary</a>
                </li>
                <li role="presentation">
                    <a data-toggle="tab" href="#accountingSheet">Accounting sheet</a>
                </li>
            </ul>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade in active" id="settlementSumary">
                </div>
                <div role="tabpanel" class="tab-pane fade" id="accountingSheet">
                    @Html.Partial("~/Reports/Views/_AccountingSheet.cshtml")
                </div>
            </div>
        </div>
    </div>
</div>