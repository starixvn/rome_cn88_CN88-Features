@model ReportFilterViewModel
<form class="form-inline filter report-form" role="form" id="report-form"
      @Html.Raw(Model.IsMobile ? " style=\"display:none;\"" : string.Empty)>
    @RenderHiddenFields()
    @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelJson)
    @Html.Hidden("IsDescendingSort", ViewData["IsDescendingSort"] as bool?)
    @Html.Hidden("SortPropertyName", ViewData["SortPropertyName"] as string)
    @Html.Hidden("IsSettlement", ViewData["IsSettlement"] as bool?)
    @SportGroupSelection.Render(Model.SportGroupSelectionViewModel, true)
    @DateRangePicker.Render(Model.DateRangePickerViewModel)
    @BetTypeSelection.Render(Model.BetTypeSelectionViewModel, true)
    @LiveStatusSelection.Render(Model.LiveStatusSelectionViewModel, true)
    <div class="form-group">
        <input type="submit" value="@SharedResources.Submit" class="btn-submit" />
    </div>
</form>
<form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("Excel","Reports")">
    @RenderHiddenFields()
    @Html.Hidden("FromDate", Model.DateRangePickerViewModel.FromDate)
    @Html.Hidden("ToDate", Model.DateRangePickerViewModel.ToDate)
    @Html.Hidden("UserSelectedSportGroupId", Model.SportGroupSelectionViewModel.UserSelectedId)
    @Html.Hidden("UserSelectedBetTypeId", Model.BetTypeSelectionViewModel.UserSelectedId)
    @Html.Hidden("UserSelectedLiveStatusId", Model.LiveStatusSelectionViewModel.UserSelectedId)
</form>
@if (Model.IsShowPermissionOnDownlinesMessage)
{
    <div class="message-container">
        <div class="msg msg-warning">@string.Format(ReportResources.PermissionOnDownlinesMessage, Model.AssignedDownlinesCount.TotalAssignedAccounts, Model.AssignedDownlinesCount.TotalDirectDownlines)</div>
    </div>

}
@helper RenderHiddenFields()
{
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("IsOwner", Model.IsOwner)
    @Html.Hidden("ReportType", Model.ReportType)
    @Html.Hidden("DisplayMode", Model.DisplayMode)
    @Html.Hidden("IsOldReport", false)
}