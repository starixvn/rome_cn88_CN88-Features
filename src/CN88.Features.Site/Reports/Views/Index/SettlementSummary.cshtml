@model IndexViewModel
@{
    var report = Model.SettlementSummaryReport;
}
<table class="tbl-noborder" id="tblSettlementSummary">
    <thead>
        <tr>
            <th></th>
            <th colspan="2">
                <span class="@(report.Yesterday.IsComplete ? "complete-settlement" : "incomplete-settlement")">
                    @(report.Yesterday.IsComplete ? ReportResources.Complete : ReportResources.Incomplete)
                </span>
                <br />
                <span>@report.Yesterday.Name</span>
            </th>
            <th colspan="2">
                <span class="@(report.Today.IsComplete ? "complete-settlement" : "incomplete-settlement")">
                    @(report.Today.IsComplete ? ReportResources.Complete : ReportResources.Incomplete)
                </span>
                <br />
                <span>@report.Today.Name</span>
            </th>
        </tr>
        <tr>
            <th></th>
            <th>@ReportResources.Unsettled</th>
            <th>@ReportResources.Settled</th>
            <th>@ReportResources.Unsettled</th>
            <th>@ReportResources.Settled</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < report.SportGroups.Count(); i++)
        {
            var sportGroup = report.SportGroups[i];
            <tr>
                <td>@sportGroup</td>
                <td class="incomplete-settlement">@report.Yesterday.Settlements[i].Unsettled</td>
                <td>@report.Yesterday.Settlements[i].Settled</td>
                <td class="incomplete-settlement">@report.Today.Settlements[i].Unsettled</td>
                <td>@report.Today.Settlements[i].Settled</td>
            </tr>
        }
    </tbody>
</table>