@model IndexViewModel

<form id="create-rpt-form" class="form-horizontal create-form filter" role="form" action="@Url.Action(Model.ActionName, "Reports")">
    @Html.Hidden("ReportType")
    @Html.Hidden("DisplayMode", Model.DisplayMode)
    @Html.Hidden("IsOwner", Model.IsOwner)
    @Html.Hidden("CustLevelId", Model.CustLevelId)
    @Html.Hidden("ThisPeriod_FromDate", Model.CurrentPeriod.FromDate.ToShortDate())
    @Html.Hidden("ThisPeriod_ToDate", Model.CurrentPeriod.ToDate.ToShortDate())
    @Html.Hidden("LastPeriod_FromDate", Model.LastPeriod.FromDate.ToShortDate())
    @Html.Hidden("LastPeriod_ToDate", Model.LastPeriod.ToDate.ToShortDate())
    @DateRangePicker.Render(Model.DateRangePickerViewModel)
    <div class="form-group has-three-buttons">
        <input id="btn-today" type="button" value="@SharedResources.Today" class="btn-quick-choice btn-default" />
        <input id="btn-yesterday" type="button" value="@SharedResources.Yesterday" class="btn-quick-choice btn-secondary" />
        <input id="btn-tomorrow" type="button" value="@SharedResources.Tomorrow" class="btn-quick-choice btn-default" />
    </div>
    <div class="form-group btn-ex-group has-two-buttons">
        <input id="btn-this-week" type="button" value="@SharedResources.ThisWeek" class="btn-quick-choice btn-default " />
        <input id="btn-last-week" type="button" value="@SharedResources.LastWeek" class="btn-quick-choice btn-default" />
    </div>
    <div class="form-group btn-ex-group has-two-buttons">
        <input id="btn-this-period" type="button" value="@SharedResources.ThisPeriod" class="btn-quick-choice btn-default" />
        <input id="btn-last-period" type="button" value="@SharedResources.LastPeriod" class="btn-quick-choice btn-default" />
    </div>
    @SportGroupSelection.Render(Model.SportGroupSelectionViewModel, false)
    @BetTypeSelection.Render(Model.BetTypeSelectionViewModel, false)
    @LiveStatusSelection.Render(Model.LiveStatusSelectionViewModel, false)
    <div class="form-group list-buttons">
        <input id="btn-clear" type="button" value="@SharedResources.Clear" class="btn btn-default" />
        <input type="submit" value="@ReportResources.ViewReport" class="btn-submit" />
    </div>
</form>
