@{
    Layout = null;
}
@model VerifyPasswordViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title></title>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      @StaticResources.AssetScripts.RenderCommon("/bundles/common/support-IE8")
    <![endif]-->
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-features/security")
    @StaticResources.RenderStyles("~/Reports/bundles/verify-password")
</head>
<body @Html.Raw(CN88.Features.Site.Shared.Helpers.BrowserManager.BuildMobileHtmlClass())>
    <div class="block">
        <div class="title-box">@SharedResources.Login</div>
        @using (Html.BeginForm("VerifyPassword", "OldReports", FormMethod.Post, new { id = "formVerifyPwd", @class = "form-security form-create-login" }))
        {
            @Html.AntiForgeryToken()
            <div id="message-container">
                @if (Model.Result != null)
                {
                    <div class="msg @(Model.Result.IsSuccess ? "msg-success" : "msg-error")">@Model.Result.Message</div>
                }
            </div>
            <div class="rowlg">
                <label class="lb-title">@SharedResources.NickName</label>
                <input type="text" class="txt" value="@Model.NickName" disabled />
            </div>
            <div class="rowlg">
                <label class="lb-title">@SharedResources.Password</label>
                <input type="password" class="txt" id="txtPassword" maxlength="16" autocomplete="off" name="Password" />
            </div>
            <div class="list-button">
                <input type="submit" class="btn-submit" value="@SharedResources.Login">
            </div>
        }
    </div>
    @Html.Hidden("HashKey", Model.HashKey)
    @Html.Hidden("password-cannot-empty", ReportResources.RequiredPasswordError)
    @Html.Hidden("password-does-not-min-requirement", ReportResources.PasswordWrongRuleError)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderScripts("~/Reports/bundles/verify-password")
</body>
</html>