@{
    Layout = "~/Reports/Views/_OldLayout.cshtml";
    var settlementActiveClass = string.IsNullOrWhiteSpace(Request["IsSettlement"]) || string.Equals(Request["IsSettlement"], bool.TrueString, StringComparison.OrdinalIgnoreCase) ?
    "active" : string.Empty;
    var validStakeActiveClass = string.Equals(Request["IsSettlement"], bool.FalseString, StringComparison.OrdinalIgnoreCase) ?
        "active" : string.Empty;
    var isSettlement = string.Equals(settlementActiveClass, "active", StringComparison.OrdinalIgnoreCase);
}
@section Styles {
    @StaticResources.RenderStyles("~/Reports/bundles/reports")
}
@model OldReportViewModel
<div class="report-detail wager-report">
    <div class="page-title title-report-detail">
        <ul class="nav nav-tabs" role="tablist">
            <li class="report-name">@Model.Title</li>
            <li role="presentation" id="tabSettlement" class="@settlementActiveClass tab-selector" target-id="settlement-content">
                <a data-toggle="tab" href="#">@ReportResources.Settlement</a>
            </li>
            @if (Model.ReportLevel.IsNotMemberLevel())
            {
                <li role="presentation" id="tabValidStake" class="@validStakeActiveClass tab-selector" target-id="valid-stake-content">
                    <a data-toggle="tab" href="#">@ReportResources.ValidStake</a>
                </li>
            }
        </ul>
        @Breadcrumb.Render(Model.BreadcrumbLevelViewModel, Request.Url.Query, null, isSettlement)
    </div>
    @Html.Partial("~/Reports/Views/OldFilter.cshtml", Model.OldReportFilterViewModel)
    @{
        if (Model.ReportLevel.IsSuperLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/SuperTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsMasterLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/MasterTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsAgentLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/AgentTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsMemberLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/MemberTable.cshtml", Model)
        }
    }
    @Pager.Render(Model.PagerViewModel)
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/Reports/bundles/old-wager")
}