@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = Model.Title;
}
@section Styles {
    @StaticResources.RenderStyles("~/Reports/bundles/reports")
}
@model ReportViewModel
<div class="report-detail wager-report">
    <div class="page-title title-report-detail">
        <ul class="nav nav-tabs" role="tablist">
            <li class="report-name">@Model.Title</li>
            <li role="presentation" id="tabSettlement" class="tab-selector @(Model.IsSettlement || Model.ReportLevel.IsMemberLevel() ? "active" : string.Empty)">
                <a data-toggle="tab" href="#">@ReportResources.Settlement</a>
            </li>
            @if (Model.ReportLevel.IsNotMemberLevel())
            {
                <li role="presentation" id="tabValidStake" class="tab-selector @(Model.IsSettlement ? string.Empty : "active")">
                    <a data-toggle="tab" href="#">@ReportResources.ValidStake</a>
                </li>
            }
        </ul>
        @Breadcrumb.Render(Model.BreadcrumbLevelViewModel, Request.Url.Query, null, Model.IsSettlement)
    </div>
    @Html.Partial("~/Reports/Views/Filter.cshtml", Model.ReportFilterViewModel,
    new ViewDataDictionary
    {
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName },
        { "IsSettlement", Model.IsSettlement }
    })
    @RenderReportTable()
    @Pager.Render(Model.PagerViewModel)
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/Reports/bundles/wager")
    <script>
        var betTypes = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReportFilterViewModel.AllBetTypeGroups.GroupBy(i => i.SportTypeGroup)));
    </script>
}
@helper RenderReportTable()
{
    if (Model.ReportLevel.IsSuperLevel())
    {
        @Html.Partial("~/Reports/Views/Wager/SuperTable.cshtml", Model)
    }
    if (Model.ReportLevel.IsMasterLevel())
    {
        @Html.Partial("~/Reports/Views/Wager/MasterTable.cshtml", Model)
    }

    if (Model.ReportLevel.IsAgentLevel())
    {
        @Html.Partial("~/Reports/Views/Wager/AgentTable.cshtml", Model)
    }

    if (Model.ReportLevel.IsMemberLevel())
    {
        @Html.Partial("~/Reports/Views/Wager/MemberTable.cshtml", Model)
    }
}