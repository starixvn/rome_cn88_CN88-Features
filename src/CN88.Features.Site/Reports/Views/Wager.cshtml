@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/Reports/bundles/reports")
}
@model ReportViewModel
<div class="report-detail">
    <div class="page-title title-report-detail">
        <ul class="nav nav-tabs" role="tablist">
            <li class="report-name">@Model.Title</li>
            <li role="presentation" class="active tab-selector" target-id="settlement-content">
                <a data-toggle="tab" href="#">@ReportResources.Settlement</a>
            </li>
            <li role="presentation" class="tab-selector" target-id="valid-stake-content">
                <a data-toggle="tab" href="#">@ReportResources.ValidStake</a>
            </li>
        </ul>
    </div>
    @Html.Partial("~/Reports/Views/_Filter.cshtml", Model.ReportFilterViewModel)
    @if (Model.ReportLevel.Value == 0)
    {
        @Html.Partial("~/Reports/Views/Wager/HeadlineTable.cshtml", Model)
    }
    else if (Model.IsNotOwner)
    {
        if (Model.ReportLevel.IsSuperLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/SuperTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsMasterLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/MasterTable.cshtml", Model)
        }

        if (Model.ReportLevel.IsAgentLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/AgentTable.cshtml", Model)
        }
    }
    else
    {
        if (Model.ReportLevel.IsSuperLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/SuperTableByUpper.cshtml", Model)
        }

        if (Model.ReportLevel.IsMasterLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/MasterTableByUpper.cshtml", Model)
        }

        if (Model.ReportLevel.IsAgentLevel())
        {
            @Html.Partial("~/Reports/Views/Wager/AgentTableByUpper.cshtml", Model)
        }
    }
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/Reports/bundles/wager")
}