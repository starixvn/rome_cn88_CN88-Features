@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/Reports/bundles/reports")
}
@model ReportViewModel
<div class="report-detail">
    <div class="page-title title-report-detail">
        <ul class="nav nav-tabs" role="tablist">
            <li class="report-name">@Model.Title</li>
            <li role="presentation" class="active">
                <a data-toggle="tab" href="#">@ReportResources.Settlement</a>
            </li>
            <li role="presentation">
                <a data-toggle="tab" href="#">@ReportResources.ValidStake</a>
            </li>
        </ul>
    </div>
    @Html.Partial("~/Reports/Views/_Filter.cshtml", Model.ReportFilterViewModel)
    <table class="tbl-noborder tbl-report">
        <thead>
            <tr>
                <th>@SharedResources.UserCode<span class="icon-sort-arrow-up"></span></th>
                <th class="valid-stake text-right">@SharedResources.Wagers<span class="icon-sort-arrow"></span></th>
                <th class="valid-stake text-right">@SharedResources.Stake<span class="icon-sort-arrow"></span></th>
                <th class="valid-stake text-right">@ReportResources.ValidStake<span class="icon-sort-arrow"></span></th>
                <th class="valid-stake text-right">@ReportResources.MemberIncome<span class="icon-sort-arrow"></span></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ReportData.Any())
            {
                foreach (var data in Model.ReportData)
                {
                    <tr>
                        <td>@data.Username</td>
                        <td class="text-right">@data.Wagers</td>
                        <td class="text-right">@data.Stake</td>
                        <td class="text-right">@data.ValidStake</td>
                        <td class="text-right">@data.MemberIncome</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-right">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/Reports/bundles/legacy")
}