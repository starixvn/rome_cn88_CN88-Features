@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@model ReportViewModel
<div class="page-title">
    <span class="pull-left">@Model.Title</span>
</div>
@Html.Partial("~/Reports/Views/_Filter.cshtml", Model.ReportFilterViewModel)
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover" id="tbl-report">
    <thead>
        <tr>
            <th>@SharedResources.UserCode</th>
            <th>@SharedResources.Wagers</th>
            <th>@SharedResources.Stake</th>
            <th>@ReportResources.ValidStake</th>
            <th>@ReportResources.MemberIncome</th>
            @if (Model.ReportLevel.IsNotMemberLevel())
            {
                <th>@SharedResources.Agent</th>
            }
            @if (Model.ReportLevel.IsMemberOrMasterLevel())
            {
                <th>@ReportResources.AgentPoss</th>
                <th>@ReportResources.AgentIncome</th>
            }
            @if (Model.ReportLevel.IsMemberLevel())
            {
                <th>@ReportResources.AgentResultA</th>
            }
            else
            {
                <th>@ReportResources.AgentResult</th>
            }
            @if (Model.ReportLevel.IsAgentLevel())
            {
                <th>@ReportResources.AgentStock</th>
                <th>@ReportResources.AgentCurrency</th>

            }
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.ReportData)
            {
            <tr>
                <td>@row.Username</td>
                <td>@row.Wagers</td>
                <td>@row.Stake</td>
                <td>@row.ValidStake</td>
                <td>@row.MemberIncome</td>
                @RenderNetWinLoss(row.AgentNetWinLoss)
                @if (Model.ReportLevel.IsAgentLevel())
                {
                    <td>@row.AgentCurrency</td>
                }
            </tr>
        }
    </tbody>
</table>
@helper RenderNetWinLoss(NetWinLoss netWinLoss)
{
if (netWinLoss == null)
{
    return;
}
if (netWinLoss.WinLoss != null)
{
        <td>@netWinLoss.WinLoss</td>
}
if (netWinLoss.Poss != null)
{
        <td>@netWinLoss.Poss</td>
}
if (netWinLoss.Income != null)
{
        <td>@netWinLoss.Income</td>

}
if (netWinLoss.Result != null)
{
        <td>@netWinLoss.Result</td>
}
if (netWinLoss.Stock != null)
{
        <td>@netWinLoss.Stock</td>
}
}
@section Scripts{
    @StaticResources.RenderScripts("~/Reports/bundles/legacy")
}