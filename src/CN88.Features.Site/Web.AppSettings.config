<appSettings>
  <add key="webpages:Version" value="3.0.0.0" />
  <add key="webpages:Enabled" value="false" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="UnobtrusiveJavaScriptEnabled" value="true" />

  <add key="StoredProcedurePath" value="App_Data/SPNames/Dev" />

  <add key="OldReports:NumberOfPeriod" value="2" />
  <add key="OldReports:ExpiredSessionSeconds" value="30" />
  <add key="MemberStatementOfLatestDay" value="8" />

  <add key="DefaultIpAddress" value="::1" />
  <add key="LocalIpAddress" value="127.0.0.1" />

  <add key="WagerMonitoringExpirationCacheInMinutes" value="15" />
  <add key="WagerMonitoringPageSize" value="300" />
  <add key="TimeToGetLastBetsInSeconds" value="10" />
</appSettings>