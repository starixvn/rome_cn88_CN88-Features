@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@model CN88.Features.SubAccount.Models.SubAccountItem
<div class="subacc-page">
    <div id="message-container"></div>
    @using (Html.BeginForm("Update", "SubAccount", FormMethod.Post, new { id = "formSubAccount", @class = "form-horizontal", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("custId", Model.SubAccId.ToString())
        <div class="form-group">
            <label class="col-sm-2 control-label">Username</label>
            <div class="col-sm-10">
                @Model.UserName
            </div>
        </div>
        <div class="form-group">
            <label for="firstName" class="col-sm-2 control-label">First Name</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" name="FirstName" id="firstName" />
            </div>
        </div>
        <div class="form-group">
            <label for="lastName" class="col-sm-2 control-label">Last Name</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" name="LastName" id="lastName" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[D]" name="PageAccess"> @SubAccountResource.TotalBets
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[H]" name="PageAccess"> @SubAccountResource.ACManagementViewOnly
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[A],[B],[H]" name="PageAccess"> @SubAccountResource.ACManagementEditView
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[E]" name="PageAccess"> @SubAccountResource.Reports
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[G]" name="PageAccess"> @SubAccountResource.Log
                    </label>
                </div>
            </div>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="buttonCancel" value="Cancel" />
            <input type="submit" class="btn-submit" value="@SharedResources.Submit" />
        </div>
    }
</div>
