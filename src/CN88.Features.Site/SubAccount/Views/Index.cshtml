@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/SubAccount/bundles/scripts/sub-account")
}
@model IndexViewModel
<div class="subacc-page">
    <div>
        <button class="btn-submit add-new" id="btnCreateSubAccount">
            <span class="icon-add"></span>Create Sub Account</button>
    </div>
    <table class="tbl-style2" id="tbl-subaccount">
        <thead>
            <tr>
                <th>@SubAccountResource.UserCode</th>
                <th>@SubAccountResource.Name</th>
                <th>@SubAccountResource.LoginId</th>
                <th>@SubAccountResource.TotalBets</th>
                <th>@SubAccountResource.ACManagementViewOnly</th>
                <th>@SubAccountResource.ACManagementEditView</th>
                <th>@SubAccountResource.Reports</th>
                <th>@SubAccountResource.CreatedDate</th>
                <th>@SubAccountResource.Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TotalItems == 0)
            {
                <tr>
                    <td colspan="9" class="text-center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.SubAccounts)
                {
                    var permission = item.Permissions;
                    <tr>
                        <td>@item.UserName</td>
                        <td>@item.FirstName @item.LastName</td>
                        <td>N/A</td>
                        @RenderPermissionCell(permission.ViewTotalBets)
                        @RenderPermissionCell(permission.ViewMemberInfo)
                        @RenderPermissionCell(permission.UpdateAccount)
                        @RenderPermissionCell(permission.ViewReports)
                        <td>@item.CreateDateString</td>
                        <td data-subaccid="@item.SubAccId" data-subaccname="@item.UserName">
                            <span class="icon-pass" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.ResetPassword"></span>
                            <span class="icon-security" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.ResetSecurityCode"></span>
                            <span class="icon-edit" data-toggle="tooltip" data-placement="top" title="@SharedResources.Edit"></span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@Html.Hidden(nameof(Model.FeaturesAppPath), Model.FeaturesAppPath)
@Html.Hidden(nameof(SubAccountResource.ResetPassword), SubAccountResource.ResetPassword)
@Html.Hidden(nameof(Model.ResetPasswordLink), Model.ResetPasswordLink)
@Html.Hidden(nameof(SubAccountResource.ResetSecurityCode), SubAccountResource.ResetSecurityCode)
@Html.Hidden(nameof(Model.ResetSecurityCodeLink), Model.ResetSecurityCodeLink)

@helper RenderPermissionCell(bool hasPermission)
{
    <td class="text-center">
        <span class="@(hasPermission ? "icon-success " : "icon-minus")"></span>
    </td>
}