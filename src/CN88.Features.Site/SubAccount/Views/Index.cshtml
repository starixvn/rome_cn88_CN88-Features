@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {

}
@section Scripts {

}
@model IEnumerable<IndexViewModel>

<table>
    <thead>
        <tr>@SubAccountResource.UserCode</tr>
        <tr>@SubAccountResource.Name</tr>
        <tr>@SubAccountResource.LoginId</tr>
        <tr>@SubAccountResource.TotalBets</tr>
        <tr>@SubAccountResource.ACManagementViewOnly</tr>
        <tr>@SubAccountResource.ACManagementEditView</tr>
        <tr>@SubAccountResource.Reports</tr>
        <tr>@SubAccountResource.CreatedDate</tr>
        <tr>@SubAccountResource.Action</tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="9">@SharedResources.NoInformationIsAvailable</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.UserName</td>
                    <td>@item.FirstName @item.LastName</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>@item.CreatedDate</td>
                    <td></td>
                </tr>
            }
        }
    </tbody>
</table>
