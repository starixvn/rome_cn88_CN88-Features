@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")
}
@section Scripts {

}
@model IndexViewModel

<div class="subacc-page">
    <table class="tbl-style2" id="tbl-subaccount">
        <thead>
            <tr>
                <th>@SubAccountResource.UserCode</th>
                <th>@SubAccountResource.Name</th>
                <th>@SubAccountResource.LoginId</th>
                <th>@SubAccountResource.TotalBets</th>
                <th>@SubAccountResource.ACManagementViewOnly</th>
                <th>@SubAccountResource.ACManagementEditView</th>
                <th>@SubAccountResource.Reports</th>
                <th>@SubAccountResource.CreatedDate</th>
                <th>@SubAccountResource.Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TotalItems == 0)
            {
                <tr>
                    <td colspan="9" class="text-center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.SubAccounts)
                {
                    var permission = item.Permissions;
                    <tr>
                        <td>@item.UserName</td>
                        <td>@item.FirstName @item.LastName</td>
                        <td>N/A</td>
                        <td>@permission.ViewTotalBets</td>
                        <td>@permission.ViewMemberInfo</td>
                        <td>@permission.UpdateAccount</td>
                        <td>@permission.ViewReports</td>
                        <td>@item.CreateDate</td>
                        <td></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
