@{
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/SubAccount/bundles/scripts/sub-account")
}
@model IndexViewModel
<div class="subacc-page">
    <div id="message-container"></div>
    <div>
        <button class="btn-submit add-new" id="btnNewSubAccount">
            <span class="icon-add"></span>@SubAccountResource.NewSubAccount</button>
    </div>
    <table class="tbl-style2" id="tbl-subaccount">
        <thead>
            <tr>
                <th>@SubAccountResource.UserCode</th>
                <th>@SubAccountResource.Name</th>
                <th>@SubAccountResource.LoginId</th>
                <th class="text-center">@SubAccountResource.TotalBets</th>
                <th class="text-center">@SubAccountResource.ACManagement @SubAccountResource.ViewOnly</th>
                <th class="text-center">@SubAccountResource.ACManagement @SubAccountResource.EditView</th>
                <th class="text-center">@SubAccountResource.Reports</th>
                <th class="text-center">@SubAccountResource.Log</th>
                <th class="text-center">@SubAccountResource.CreatedDate</th>
                <th class="text-center">@SubAccountResource.Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TotalItems == 0)
            {
                <tr>
                    <td colspan="10" class="text-center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.SubAccounts)
                {
                    var permission = item.Permissions;
                    <tr>
                        <td>@item.UserName</td>
                        <td>@item.FirstName @item.LastName</td>
                        <td>N/A</td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.ViewTotalBets)
                        </td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.ViewMemberInfo)
                        </td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.UpdateAccount)
                        </td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.ViewReports)
                        </td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.ViewLog)
                        </td>
                        <td>@item.CreateDateString</td>
                        <td class="text-center" data-subaccid="@item.SubAccId" data-subaccname="@item.UserName">
                            @RenderActionCell()
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@Html.Hidden(nameof(SubAccountResource.NewSubAccount), SubAccountResource.NewSubAccount)
@Html.Hidden(nameof(SubAccountResource.EditSubAccount), SubAccountResource.EditSubAccount)
@Html.Hidden(nameof(SubAccountResource.DeleteSubAccount), SubAccountResource.DeleteSubAccount)
@Html.Hidden(nameof(SubAccountResource.ConfirmDeleteSubAccount), SubAccountResource.ConfirmDeleteSubAccount)
@Html.Hidden(nameof(SubAccountResource.ResetPassword), SubAccountResource.ResetPassword)
@Html.Hidden(nameof(SubAccountResource.ResetSecurityCode), SubAccountResource.ResetSecurityCode)

@Html.Hidden(nameof(Model.NewSubAccountLink), Model.NewSubAccountLink)
@Html.Hidden(nameof(Model.EditSubAccountLink), Model.EditSubAccountLink)
@Html.Hidden(nameof(Model.DeleteSubAccountLink), Model.DeleteSubAccountLink)
@Html.Hidden(nameof(Model.ResetPasswordLink), Model.ResetPasswordLink)
@Html.Hidden(nameof(Model.ResetSecurityCodeLink), Model.ResetSecurityCodeLink)

@helper RenderPermissionCell(bool hasPermission)
{
    <span class="@(hasPermission ? "icon-success " : "icon-minus")"></span>
}
@helper RenderActionCell()
{
    <span class="icon-pass" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.ResetPassword"></span>
    <span class="icon-security" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.ResetSecurityCode"></span>
    <span class="icon-edit" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.EditSubAccount"></span>
    <span class="icon-delete" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.DeleteSubAccount"></span>
}
