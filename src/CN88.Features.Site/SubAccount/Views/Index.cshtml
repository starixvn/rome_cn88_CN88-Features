@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = CN88.Features.SubAccount.AppResources.SubAccountResource.SubAccount;
}
@section Styles {
    @StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/SubAccount/bundles/scripts/sub-account")
}
@model IndexViewModel
<div class="subacc-page">
    <div id="message-container"></div>
    <div>
        <button class="btn-submit add-new" id="btnNewSubAccount">
            <span class="icon-add"></span>@SubAccountResource.NewSubAccount
        </button>
    </div>
    <table class="tbl-style2"
           id="tbl-subaccount"
           data-totalrecords="@Model.SubAccounts.Count()"
           data-sortedcolumn="UserName"
           data-descendingsort="false">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th class="header sorting" data-colindex="0" data-sortedname="UserName">@SubAccountResource.UserName</th>
                <th class="header sorting hide-mobile" data-colindex="1" data-sortedname="FirstName">@SubAccountResource.Name</th>
                <th class="header sorting" data-colindex="2" data-sortedname="NickName">@SubAccountResource.NickName</th>
                <th class="text-center">@SubAccountResource.TotalBets</th>
                <th class="text-center hide-mobile">@SubAccountResource.ACManagement<br />@SubAccountResource.ViewOnly</th>
                <th class="text-center hide-mobile">@SubAccountResource.ACManagement<br />@SubAccountResource.EditView</th>
                <th class="text-center visible-mobile">@SubAccountResource.ACM<br />@SubAccountResource.ViewOnly</th>
                <th class="text-center visible-mobile">@SubAccountResource.ACM<br />@SubAccountResource.EditView</th>
                <th class="text-center">@SubAccountResource.Reports</th>
                <th class="header sorting hide-mobile" data-colindex="7" data-sortedname="CreateDateString">@SubAccountResource.CreatedDate</th>
                <th>@SubAccountResource.Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.SubAccounts.Any())
            {
                foreach (var item in Model.SubAccounts)
                {
                    var permission = item.Permissions;
                    <tr>
                        <td><div class="username">@item.UserName</div></td>
                        <td class="hide-mobile">@WebUtility.HtmlDecode(item.FirstName)</td>
                        <td>@item.NickName</td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.ViewTotalBets)
                        </td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.ViewMemberInfo)
                        </td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.UpdateAccount)
                        </td>
                        <td class="text-center">
                            @RenderPermissionCell(permission.ViewReports)
                        </td>
                        <td class="hide-mobile">@item.CreateDateString</td>
                        <td class="col-action" data-subaccid="@item.SubAccId" data-subaccname="@item.UserName">
                            <span class="dropdown">
                                <span class="icon-more-action" data-toggle="dropdown">ABC</span>
                                <ul id="dropdown-@item.SubAccId" class="visible-mobile dropdown-menu">
                                    @RenderActionCell_Mobile()
                                </ul>
                            </span>
                            @RenderActionCell(item.Closed)
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">@SharedResources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@Html.AntiForgeryToken() @*AntiForgeryToken for unlock sub-account*@
@Html.Hidden(nameof(SubAccountResource.NewSubAccount), SubAccountResource.NewSubAccount)
@Html.Hidden(nameof(SubAccountResource.EditSubAccount), SubAccountResource.EditSubAccount)
@Html.Hidden(nameof(SubAccountResource.ResetPassword), SubAccountResource.ResetPassword)
@Html.Hidden(nameof(SubAccountResource.ResetSecurityCode), SubAccountResource.ResetSecurityCode)
@Html.Hidden(nameof(SubAccountResource.UnlockAccountConfirmMessage), SubAccountResource.UnlockAccountConfirmMessage)
@Html.Hidden(nameof(SubAccountResource.UnlockSubAccount), SubAccountResource.UnlockSubAccount)
@Html.Hidden(nameof(SharedResources.OK), SharedResources.OK)
@Html.Hidden(nameof(SharedResources.Cancel), SharedResources.Cancel)
@Html.Hidden(nameof(Model.NewSubAccountLink), Model.NewSubAccountLink)
@Html.Hidden(nameof(Model.EditSubAccountLink), Model.EditSubAccountLink)
@Html.Hidden(nameof(Model.ResetPasswordLink), Model.ResetPasswordLink)
@Html.Hidden(nameof(Model.ResetSecurityCodeLink), Model.ResetSecurityCodeLink)
@Html.Hidden(nameof(Model.UnlockSubAccountLink), Model.UnlockSubAccountLink)
@Html.Hidden(nameof(Model.VerifySecurityCodeLink), Model.VerifySecurityCodeLink)
@helper RenderPermissionCell(bool hasPermission)
{
    <span class="@(hasPermission ? "icon-success " : "icon-minus")"></span>
}
@helper RenderActionCell(bool isClosed)
{
    <span class="icon-pass hide-mobile" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.ResetPassword"></span>
    <span class="icon-security hide-mobile" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.ResetSecurityCode"></span>
    <span class="icon-edit hide-mobile" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.EditSubAccount"></span>
    if (isClosed)
    {
        <span class="icon-unlock" data-toggle="tooltip" data-placement="top" title="@SubAccountResource.ClickToUnlock"></span>
    }
}
@helper RenderActionCell_Mobile()
{
    <li>
        <span class="opt-pass">@SubAccountResource.ResetPassword</span>
    </li>
    <li>
        <span class="opt-security">@SubAccountResource.ResetSecurityCode</span>
    </li>
    <li>
        <span class="opt-edit">@SubAccountResource.EditSubAccount</span>
    </li>
}