@{
    /**/

    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = "Sub Account";
}
@section Styles {
    @StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/SubAccount/bundles/scripts/new-sub-account")
}
@model NewViewModel
<div class="modal-sub-account">
    <div id="message-container" class="message-container"></div>
    @using (Html.BeginForm("New", "SubAccount", FormMethod.Post, new { id = "formSubAccount", @class = "form-horizontal", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        <div class="head-title">@SubAccountResource.AccountDetails</div>

        <div class="general-info account-data">
            <div class="title">@SubAccountResource.GeneralData</div>
            <div class="account-data-content">
                <div class="form-group">
                    <label class="control-label required">@SubAccountResource.UserName <span class="star">*</span></label>
                    <div class="content-control username-box">
                        <label class="name">@Model.SubAccountName</label>
                        <div class="suffix-container">
                            @Html.DropDownList("suffix1", Model.Suffix1, new { id = "suffix1" })
                            @Html.DropDownList("suffix2", Model.Suffix2, new { id = "suffix2" })
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="name" class="control-label">@SubAccountResource.Name</label>
                    <div class="content-control">
                        <input type="text" class="control" maxlength="50" id="name" autocomplete="off" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="password" class="control-label">
                        @SubAccountResource.Password <span class="star">*</span>
                        <span class="icon-info" data-toggle="tooltip" data-placement="right" id="pass-rule" data-html="true" title="@SubAccountResource.PasswordRule"></span>
                    </label>
                    <div class="content-control">
                        <input type="password" class="control" maxlength="12" id="password" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="confirmPassword" class="control-label">@SubAccountResource.ConfirmPassword <span class="star">*</span></label>
                    <div class="content-control">
                        <input type="password" class="control" maxlength="12" id="confirmPassword" />
                    </div>
                </div>
            </div>
        </div>
        {
            var pageAccess = new Sunplus.Agent.Model.Entities.PageAccess();
            pageAccess.ViewReports = true;
            pageAccess.ViewTotalBets = true;
            Html.RenderPartial("~/SubAccount/Views/_Permissions.cshtml", pageAccess, ViewData);
        }
        <div class="head-title">@SubAccountResource.ManagedAccount</div>
        <table class="tbl-style2 tbl-managed-account">
            <thead>
                <tr>
                    <th>@SubAccountResource.UserName</th>
                    <th>@SubAccountResource.Name</th>
                    <th class="col-all-check">
                        <input type="checkbox" name="chkAll" value="" />
                        <span class="icon-info" />
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>TpT02</td>
                    <td>John Doe</td>
                    <td class="text-center"><input type="checkbox" name="name" value="" /></td>
                </tr>
                <tr>
                    <td>TpT03</td>
                    <td>John Connor</td>
                    <td class="text-center"><input type="checkbox" name="name" value="" /></td>
                </tr>
            </tbody>
        </table>
        <div class="list-button text-right">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@SharedResources.Cancel" />
            <input type="submit" class="btn-submit" value="@SharedResources.SaveAndNew" />
            <input type="submit" class="btn-submit" value="@SharedResources.Save" />
        </div>
    }
</div>
@Html.Hidden(nameof(Model.HashKey), Model.HashKey)
@Html.Hidden(nameof(SubAccountResource.RequiredNameError), SubAccountResource.RequiredNameError)
@Html.Hidden(nameof(SubAccountResource.RequiredPasswordError), SubAccountResource.RequiredPasswordError)
@Html.Hidden(nameof(SubAccountResource.PasswordWrongRuleError), SubAccountResource.PasswordWrongRuleError)
@Html.Hidden(nameof(SubAccountResource.ConfirmPasswordError), SubAccountResource.ConfirmPasswordError)