@model ManagedAccountViewModel
<table id="tblManagedAccount" class="tbl-style2 tbl-managed-account">
    <thead>
        <tr>
            <th>@SubAccountResource.UserName</th>
            <th>@SubAccountResource.Name</th>
            <th class="col-all-check">
                <div class="all-check-func">
                    <input type="checkbox" id="ckboxSelectAll" name="ckboxSelectAll" value="" @(Model.IsAllDownline ? "checked=checked" : string.Empty) />
                    <span class="icon-info" data-toggle="tooltip" title="@SubAccountResource.SelectAllDownlineMessage" />
                </div>                
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model.ManagedAccounts)
        {
            <tr>
                <td>@account.Username</td>
                <td>@account.FirstName</td>
                <td align="center">
                    <input type="checkbox" name="@account.CustId" value="@account.CustId" @(account.Assigned ? "checked=checked" : string.Empty) />
                </td>
            </tr>
        }
    </tbody>
</table>
@Html.Hidden(nameof(SharedResources.OK), SharedResources.OK)
@Html.Hidden(nameof(SubAccountResource.SystemMessage), SubAccountResource.SystemMessage)
@Html.Hidden(nameof(SubAccountResource.SelectAllDownlineMessage), SubAccountResource.SelectAllDownlineMessage)