@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = "Sub Account";
}
@section Styles {
    @*@StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")*@
}
@section Scripts {
    @StaticResources.RenderScripts("~/SubAccount/bundles/scripts/edit-sub-account")
}
@model CN88.Features.SubAccount.Models.SubAccountItem
<div class="subacc-page">
    <div id="message-container"></div>
    @using (Html.BeginForm("Edit", "SubAccount", FormMethod.Post, new { id = "formSubAccount", @class = "form-horizontal", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("subAccountId", Model.SubAccId.ToString())
        <div class="form-group">
            <label class="col-sm-2 control-label">@SubAccountResource.UserName</label>
            <div class="col-sm-10">
                @Model.UserName
            </div>
        </div>
        <div class="form-group">
            <label for="name" class="col-sm-2 control-label">@SubAccountResource.Name</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" maxlength="50" value="@Model.FirstName" id="name" />
            </div>
        </div>
        { Html.RenderPartial("~/SubAccount/Views/_Permissions.cshtml", Model.Permissions); }
    }
</div>
