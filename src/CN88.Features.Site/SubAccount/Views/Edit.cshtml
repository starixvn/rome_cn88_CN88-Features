@using Sunplus.Agent.Model.Entities;
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = CN88.Features.SubAccount.AppResources.SubAccountResource.SubAccount;
}
@section Styles {
    @StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/SubAccount/bundles/scripts/edit-sub-account")
}
@model EditViewModel
<div class="modal-sub-account">
    <div id="message-container" class="message-container"></div>
    @using (Html.BeginForm("Edit", "SubAccount", FormMethod.Post, new { id = "formSubAccount", @class = "form-horizontal", novalidate = "novalidate" }))
    {
        var subAccount = Model.SubAccountItem;
        @Html.AntiForgeryToken()
        @Html.Hidden("subAccountId", subAccount.SubAccId.ToString())
        <div class="head-title" data-target="#accountDetails">@SubAccountResource.AccountDetails (@Model.NumberOfDownline)</div>
        <div id="accountDetails">
            @{
                Html.RenderPartial("~/SubAccount/Views/_EditGeneralInfo.cshtml", subAccount);
                Html.RenderPartial(
                "~/SubAccount/Views/_Permissions.cshtml",
                new Tuple<bool, PageAccess>((bool)ViewBag.ShowAccountManagementPermission, subAccount.Permissions));
            }
        </div>
        <div class="head-title" data-target="#tblManagedAccount">@SubAccountResource.ManagedAccount</div>
        @Html.Partial("~/SubAccount/Views/_ManagedAccountTable.cshtml", Model.ManagedAccountViewModel)
        <div class="list-button text-right">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@SharedResources.Cancel" />
            <input type="submit" class="btn-submit" value="@SharedResources.Save" />
        </div>
    }
</div>
@Html.Hidden(nameof(SubAccountResource.RequiredNameError), SubAccountResource.RequiredNameError)
@Html.Hidden("SuccessMessage", SubAccountResource.UpdateSuccessfully)