@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = "Sub Account";
}
@section Styles {
    @StaticResources.RenderStyles("~/SubAccount/bundles/styles/sub-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/SubAccount/bundles/scripts/edit-sub-account")
}
@model CN88.Features.SubAccount.Models.SubAccountItem
<div class="modal-sub-account">
    <div id="message-container"></div>
    <div class="head-title">@SubAccountResource.AccountDetails</div>
    @using (Html.BeginForm("Edit", "SubAccount", FormMethod.Post, new { id = "formSubAccount", @class = "form-horizontal", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("subAccountId", Model.SubAccId.ToString())
        <div class="general-info account-data">
            <div class="title">@SubAccountResource.GeneralData</div>
            <div class="account-data-content">
                <div class="form-group">
                    <label class="control-label">@SubAccountResource.UserName</label>
                    <div class="content-control">@Model.UserName</div>
                </div>
                <div class="form-group">
                    <label for="name" class="control-label">@SubAccountResource.Name</label>
                    <div class="content-control">
                        <input type="text" class="control" maxlength="50" value="@WebUtility.HtmlDecode(Model.FirstName)" id="name" autocomplete="off" />
                    </div>
                </div>
            </div>
        </div>
        { Html.RenderPartial("~/SubAccount/Views/_Permissions.cshtml", Model.Permissions); }
        <div class="list-button text-right">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@SharedResources.Cancel" />
            <input type="submit" class="btn-submit" value="@SharedResources.Save" />
        </div>
    }
</div>
@Html.Hidden(nameof(SubAccountResource.RequiredNameError), SubAccountResource.RequiredNameError)