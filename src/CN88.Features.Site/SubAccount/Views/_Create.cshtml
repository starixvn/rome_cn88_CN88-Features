@{
    Layout = null;
}
@model CreateViewModel
<div class="subacc-page">
    <div id="message-container"></div>
    @using (Html.BeginForm("Create", "SubAccount", FormMethod.Post, new { id = "formSubAccount", @class = "form-horizontal", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label class="col-sm-2 control-label">Username</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="userName" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-2 control-label">Password</label>
            <div class="col-sm-10">
                <input type="password" class="form-control" id="password" />
            </div>
        </div>
        <div class="form-group">
            <label for="FirstName" class="col-sm-2 control-label">First Name</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="firstName" />
            </div>
        </div>
        <div class="form-group">
            <label for="LastName" class="col-sm-2 control-label">Last Name</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="lastName" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[D]" id="totalBets"> @SubAccountResource.TotalBets
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[H]" id="acManagementViewOnly"> @SubAccountResource.ACManagementViewOnly
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[A],[B],[H]" id="acManagementEditView"> @SubAccountResource.ACManagementEditView
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" value="[E]" id="reports"> @SubAccountResource.Reports
                    </label>
                </div>
            </div>
        </div>
    }
</div>
@Html.Hidden("hashKey", Model.HashKey)
@Html.Hidden("requiredPasswordError", SubAccountResource.RequiredPasswordError)
@Html.Hidden("passwordWrongRuleError", SubAccountResource.PasswordWrongRuleError)
